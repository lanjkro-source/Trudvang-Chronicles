<article class="trudvang chat-card open-trait-roll">
  <header><img src="{{actorImg}}"><div><strong>{{actorName}}</strong><h3>{{label}}</h3></div></header>
  <div class="damage-result">{{total}}</div>
  {{#unless resultOnly}}<p>{{localize "TRUDVANG.Roll.OpenTraitFormula"}}: {{rolls}} + {{trait}} + {{bonus}} + {{effect}}</p>
  {{#if flavor}}<div class="roll-flavor">{{{flavor}}}</div>{{/if}}{{/unless}}
</article>
