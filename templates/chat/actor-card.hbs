<article class="trudvang chat-card item actor-card" data-actor-uuid="{{actor.uuid}}">
  <header><img src="{{actor.img}}" alt=""><div><button type="button" class="card-title" data-action="open-actor-sheet">{{actor.name}}</button><small>{{localize (concat "TYPES.Actor." actor.type)}}</small></div></header>
  <div class="card-flavor shared-description">{{{description}}}</div>
</article>
