<section class="damage-targets" data-damage-targets data-damage="{{total}}">
  <div class="damage-targets-heading"><h4>{{localize "TRUDVANG.Damage.Targets"}}</h4><button type="button" data-action="add-damage-targets" title="{{localize 'TRUDVANG.Damage.AddSelectedTokens'}}" aria-label="{{localize 'TRUDVANG.Damage.AddSelectedTokens'}}"><i class="fas fa-plus"></i></button></div>
  {{#each targets}}
  <div class="damage-target"><img src="{{img}}"><span>{{name}}</span><button type="button" data-action="apply-damage" data-target-actor-uuid="{{actorUuid}}" data-target-token-uuid="{{tokenUuid}}" data-damage="{{../total}}" title="{{localize 'TRUDVANG.Damage.Apply'}}"><i class="fas fa-heart-crack"></i></button><button type="button" data-action="apply-damage" data-ignore-armor="true" data-target-actor-uuid="{{actorUuid}}" data-target-token-uuid="{{tokenUuid}}" data-damage="{{../total}}" title="{{localize 'TRUDVANG.Damage.ApplyIgnoringArmor'}}"><i class="fas fa-burst"></i></button><button type="button" data-action="apply-defense-damage" data-target-item-uuid="{{defenseItemUuid}}" data-damage="{{../total}}" title="{{#if defenseItemName}}{{localize 'TRUDVANG.Damage.ApplyToDefense' item=defenseItemName}}{{else}}{{localize 'TRUDVANG.Damage.NoDefenseItem'}}{{/if}}" {{#unless defenseItemUuid}}disabled{{/unless}}><i class="fas fa-shield"></i></button></div>
  {{/each}}
</section>
