<section class="damage-targets" data-damage-targets data-damage="{{total}}">
  <div class="damage-targets-heading"><h4>{{localize "TRUDVANG.Damage.Targets"}}</h4><button type="button" class="damage-target-edit" data-action="add-damage-targets" title="{{localize 'TRUDVANG.Damage.AddSelectedTokens'}}" aria-label="{{localize 'TRUDVANG.Damage.AddSelectedTokens'}}"><i class="fas fa-plus" aria-hidden="true"></i></button></div>
  {{#each targets}}
  <div class="damage-target"><img src="{{img}}">
    {{#if tokenUuid}}<button type="button" class="trait-situation-token damage-target-name" data-action="locate-trait-situation-token" data-token-uuid="{{tokenUuid}}" title="{{localize 'TRUDVANG.Dialog.TraitSituationTokenHint'}}">{{name}}</button>{{else}}<span class="damage-target-name">{{name}}</span>{{/if}}
    <button type="button" data-action="apply-damage" data-target-actor-uuid="{{actorUuid}}" data-target-token-uuid="{{tokenUuid}}" data-damage="{{../total}}" title="{{localize 'TRUDVANG.Damage.Apply'}}"><i class="fas fa-heart-crack"></i></button><button type="button" data-action="apply-damage" data-ignore-armor="true" data-target-actor-uuid="{{actorUuid}}" data-target-token-uuid="{{tokenUuid}}" data-damage="{{../total}}" title="{{localize 'TRUDVANG.Damage.ApplyIgnoringArmor'}}"><i class="fas fa-burst"></i></button><button type="button" data-action="apply-defense-damage" data-target-item-uuid="{{defenseItemUuid}}" data-damage="{{../total}}" title="{{#if defenseItemName}}{{localize 'TRUDVANG.Damage.ApplyToDefense' item=defenseItemName}}{{else}}{{localize 'TRUDVANG.Damage.NoDefenseItem'}}{{/if}}" {{#unless defenseItemUuid}}disabled{{/unless}}><i class="fas fa-shield"></i></button>
    <button type="button" class="damage-target-edit" data-action="remove-damage-target" data-target-actor-uuid="{{actorUuid}}" title="{{localize 'TRUDVANG.Damage.RemoveTarget'}}" aria-label="{{localize 'TRUDVANG.Damage.RemoveTarget'}}"><i class="fas fa-minus" aria-hidden="true"></i></button>
  </div>
  {{/each}}
</section>
