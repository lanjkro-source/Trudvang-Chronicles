<article class="trudvang chat-card {{kind}} {{#if success}}success{{else}}failure{{/if}}" {{#if ruleTests.length}}data-rule-document-uuid="{{itemUuid}}"{{/if}} {{#if effectTarget.actorUuid}}data-target-actor-uuid="{{effectTarget.actorUuid}}"{{/if}} {{#if effectTarget.tokenUuid}}data-target-token-uuid="{{effectTarget.tokenUuid}}"{{/if}}>
  <header><img src="{{actorImg}}"><div><strong>{{actorName}}</strong><h3>{{label}}</h3></div></header>
  <div class="roll-result"><span class="die">{{result}}</span>{{#if multipleAttackTargets}}<button type="button" class="roll-detail-toggle" data-action="toggle-roll-details" aria-expanded="false" title="{{localize 'TRUDVANG.Inspection.Inspect'}}"><i class="fas fa-circle-info"></i></button>{{else}}<span class="versus">≤</span><button type="button" class="target roll-detail-toggle" data-action="toggle-roll-details" aria-expanded="false">{{target}}</button>{{/if}}</div>
  {{#if multipleAttackTargets}}<ul class="attack-target-results">{{#each attackTargets as |entry|}}<li class="attack-target-result {{#if entry.success}}success{{else}}failure{{/if}}"><strong>{{entry.name}}</strong><span>{{localize "TRUDVANG.Dialog.FinalTarget"}} : {{entry.target}}</span><span>{{#if entry.success}}{{localize "TRUDVANG.Roll.Success"}}{{else}}{{localize "TRUDVANG.Roll.Failure"}}{{/if}}{{#if entry.critical}} — {{localize (concat "TRUDVANG.Roll.Critical." entry.critical)}}{{/if}}</span></li>{{/each}}</ul>{{else}}
  <p class="outcome">{{#if success}}{{localize "TRUDVANG.Roll.Success"}}{{else}}{{localize "TRUDVANG.Roll.Failure"}}{{/if}}{{#if critical}} — {{#if fatalEffect}}{{localize "TRUDVANG.Roll.FatalFailure"}}{{else}}{{localize (concat "TRUDVANG.Roll.Critical." critical)}}{{/if}}{{/if}}</p>
  {{#if success}}<p class="success-margin">{{localize "TRUDVANG.Roll.Margin"}} : <strong>{{margin}}</strong></p>{{/if}}
  {{/if}}
  {{#if success}}{{#if successConsequence}}<p class="success-consequence">{{successConsequence}}</p>{{/if}}{{/if}}
  {{#unless success}}{{#if failureConsequence}}<p class="failure-consequence">{{failureConsequence}}</p>{{/if}}{{/unless}}
  {{#if critical}}{{#if success}}{{#if criticalSuccessConsequence}}<p class="success-consequence critical-consequence">{{criticalSuccessConsequence}}</p>{{/if}}{{else}}{{#if criticalFailureConsequence}}<p class="failure-consequence critical-consequence">{{criticalFailureConsequence}}</p>{{/if}}{{/if}}{{/if}}
  {{#if success}}{{#if feint}}<p class="feint-result">{{localize "TRUDVANG.Roll.FeintParry" points=feint}}</p>{{/if}}{{/if}}
  {{#if flavor}}<div class="card-flavor roll-details is-collapsed" data-roll-details hidden>{{{flavor}}}</div>{{/if}}
  {{#if success}}{{#if (eq kind "attack")}}{{#if itemUuid}}<button type="button" data-action="damage" data-actor-uuid="{{actorUuid}}" data-item-uuid="{{itemUuid}}" data-usage="{{usage}}" data-long-range="{{longRange}}"><i class="fas fa-burst"></i> {{localize "TRUDVANG.Action.RollDamage"}}</button>{{else}}{{#if naturalDamage}}<button type="button" data-action="damage" data-actor-uuid="{{actorUuid}}" data-natural-damage="true"><i class="fas fa-burst"></i> {{localize "TRUDVANG.Action.RollDamage"}}</button>{{/if}}{{/if}}{{/if}}{{/if}}
  {{#if fatalEffect}}<button type="button" data-action="roll-fatal-effect" data-actor-uuid="{{actorUuid}}" data-fatal-kind="{{fatalEffect.kind}}" data-fatal-threshold="{{fatalEffect.threshold}}" data-fatal-modifier="{{fatalEffect.modifier}}"><i class="fas fa-dice-d10"></i> {{#if (eq fatalEffect.kind "faith")}}{{localize "TRUDVANG.Action.RollFatalFailure"}}{{else}}{{localize "TRUDVANG.Action.RollFatalMagic"}}{{/if}}</button>{{/if}}
  {{#if ruleTests.length}}<ul class="rule-action-tests">{{#each ruleTests as |test|}}<li><button type="button" data-action="roll-rule-test" data-test-index="{{test.index}}" title="{{test.title}}"><i class="fas fa-dice-d20" aria-hidden="true"></i> {{test.action}}</button></li>{{/each}}</ul>{{/if}}
</article>
