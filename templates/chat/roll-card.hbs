<article class="trudvang chat-card {{kind}} {{#if success}}success{{else}}failure{{/if}}">
  <header><img src="{{actorImg}}"><div><strong>{{actorName}}</strong><h3>{{label}}</h3></div></header>
  <div class="roll-result"><span class="die">{{result}}</span><span class="versus">≤</span><button type="button" class="target roll-detail-toggle" data-action="toggle-roll-details" aria-expanded="false">{{target}}</button></div>
  <p class="outcome">{{#if success}}{{localize "TRUDVANG.Roll.Success"}}{{else}}{{localize "TRUDVANG.Roll.Failure"}}{{/if}}{{#if critical}} — {{#if fatalEffect}}{{localize "TRUDVANG.Roll.FatalFailure"}}{{else}}{{localize (concat "TRUDVANG.Roll.Critical." critical)}}{{/if}}{{/if}}</p>
  {{#if success}}<p class="success-margin">{{localize "TRUDVANG.Roll.Margin"}} : <strong>{{margin}}</strong></p>{{/if}}
  {{#if success}}{{#if feint}}<p class="feint-result">{{localize "TRUDVANG.Roll.FeintParry" points=feint}}</p>{{/if}}{{/if}}
  {{#if flavor}}<div class="card-flavor roll-details is-collapsed" data-roll-details hidden>{{{flavor}}}</div>{{/if}}
  {{#if success}}{{#if (eq kind "attack")}}{{#if itemUuid}}<button type="button" data-action="damage" data-actor-uuid="{{actorUuid}}" data-item-uuid="{{itemUuid}}" data-usage="{{usage}}" data-long-range="{{longRange}}"><i class="fas fa-burst"></i> {{localize "TRUDVANG.Action.RollDamage"}}</button>{{else}}{{#if naturalDamage}}<button type="button" data-action="damage" data-actor-uuid="{{actorUuid}}" data-natural-damage="true"><i class="fas fa-burst"></i> {{localize "TRUDVANG.Action.RollDamage"}}</button>{{/if}}{{/if}}{{/if}}{{/if}}
  {{#if fatalEffect}}<button type="button" data-action="roll-fatal-effect" data-actor-uuid="{{actorUuid}}" data-fatal-kind="{{fatalEffect.kind}}" data-fatal-threshold="{{fatalEffect.threshold}}" data-fatal-modifier="{{fatalEffect.modifier}}"><i class="fas fa-dice-d10"></i> {{#if (eq fatalEffect.kind "faith")}}{{localize "TRUDVANG.Action.RollFatalFailure"}}{{else}}{{localize "TRUDVANG.Action.RollFatalMagic"}}{{/if}}</button>{{/if}}
</article>
