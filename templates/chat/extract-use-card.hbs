<article class="trudvang chat-card extract-use">
  <header><img src="{{itemImg}}" alt=""><div><strong>{{actorName}}</strong><h3>{{itemName}}</h3></div></header>
  <div class="roll-result"><span class="die">{{result}}</span></div>
  <p class="card-flavor">{{localize "TRUDVANG.Extract.RollFormula" die=die strength=strength trait=traitName modifier=traitModifier result=result}}</p>
  <div class="extract-stage-result">
    <p class="extract-stage"><strong>{{localize "TRUDVANG.Extract.Stage" stage=stageLabel}}</strong></p>
    <p class="extract-duration">({{#if ends}}{{localize "TRUDVANG.Extract.DurationEnds" duration=duration}}{{else}}{{localize "TRUDVANG.Extract.DurationUntil" duration=duration stage=nextStageLabel}}{{/if}})</p>
    <p class="extract-effect">{{stageEffect}}</p>
  </div>
</article>
