<article class="trudvang chat-card name-roll">
  <header>
    <i class="fas fa-signature" aria-hidden="true"></i>
    <div>
      <h3>{{tableName}}</h3>
      {{#if genderLabel}}<strong>{{genderLabel}}</strong>{{/if}}
    </div>
  </header>
  <p class="name-roll-name">{{name}}</p>
  <p class="name-roll-parts">{{prefix}} + {{suffix}}</p>
</article>
