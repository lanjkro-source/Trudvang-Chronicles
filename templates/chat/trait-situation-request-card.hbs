<article class="trudvang chat-card trait-situation-request{{#if environment}} environment-request{{/if}}">
  {{#if environment}}<header><h3>{{title}}</h3></header>{{else}}<header>
    <img src="{{gmImg}}" alt="">
    <div>
      <strong>{{gmName}}</strong>
      <h3>{{title}}</h3>
    </div>
  </header>{{/if}}
  <p class="card-flavor">{{#if environment}}{{localize "TRUDVANG.Environment.cardHint"}}{{else}}{{localize "TRUDVANG.Dialog.TraitSituationHint"}}{{/if}}</p>
  <button type="button" data-action="roll-trait-situation" data-trait="{{traitKey}}" data-sv="{{sv}}">
    <i class="fas fa-shield-halved" aria-hidden="true"></i> {{buttonLabel}}
  </button>
  {{#if environment}}
  {{#if environmentLines.length}}<ul class="environment-conditions">{{#each environmentLines}}<li>{{this}}</li>{{/each}}</ul>{{/if}}
  <p class="environment-total"><strong>{{localize "TRUDVANG.Environment.total"}} : {{environmentTotal}}</strong></p>
  {{#if environmentFrostbite}}<p class="environment-note"><em>{{environmentFrostbite}}</em></p>{{/if}}
  {{/if}}
  {{#if success}}
  <p class="trait-situation-consequence trait-situation-consequence--success">
    <strong>{{localize "TRUDVANG.Dialog.TraitSituationResult.success"}} :</strong> {{success}}
  </p>
  {{/if}}
  {{#if failure}}
  <p class="trait-situation-consequence trait-situation-consequence--failure">
    <strong>{{localize "TRUDVANG.Dialog.TraitSituationResult.failure"}} :</strong> {{failure}}
  </p>
  {{/if}}
  {{#if responses.length}}
  <ul class="trait-situation-results" aria-label="{{localize "TRUDVANG.Dialog.TraitSituationResults"}}">
    {{#each responses}}
    <li class="trait-situation-result trait-situation-result--{{outcome}}">
      {{#if tokenUuid}}
      <button type="button" class="trait-situation-token" data-action="locate-trait-situation-token" data-token-uuid="{{tokenUuid}}" title="{{localize "TRUDVANG.Dialog.TraitSituationTokenHint"}}">{{name}}</button>
      {{else}}
      <span class="trait-situation-token-name">{{name}}</span>
      {{/if}}
      <strong class="trait-situation-die">{{result}}</strong>
      <strong class="trait-situation-outcome">{{outcomeLabel}}</strong>
      {{#if ../environment}}<button type="button" data-action="apply-environment-fatigue" data-actor-uuid="{{actorUuid}}" {{#if fatigueApplied}}disabled{{/if}} title="{{localize "TRUDVANG.Environment.addFatigue"}}"><i class="fas fa-person-walking"></i> {{localize "TRUDVANG.Content.Item.Fatigued.Name"}}{{#if fatigueApplied}} ✓{{/if}}</button>{{/if}}
    </li>
    {{/each}}
  </ul>
  {{/if}}
</article>
