<article class="trudvang chat-card portrait-card">
  <header><img src="{{actorImg}}" alt=""><div><strong>{{actorName}}</strong><h3>{{localize "TRUDVANG.Portrait.CardTitle"}}</h3></div></header>
  <button type="button" class="portrait-share" data-action="show-portrait" data-uuid="{{actorUuid}}" data-src="{{actorImg}}" data-title="{{actorName}}" title="{{actorName}}">
    <img src="{{actorImg}}" alt="{{actorName}}">
  </button>
</article>
