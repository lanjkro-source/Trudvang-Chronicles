<article class="trudvang chat-card item"><header><img src="{{item.img}}"><div><h3>{{item.name}}</h3><small>{{localize (concat "TYPES.Item." item.type)}}</small></div></header><div class="card-flavor">{{{description}}}</div>{{#if canApplyEffects}}<button type="button" data-action="apply-effects" data-item-uuid="{{item.uuid}}"><i class="fas fa-person-rays"></i> {{localize "TRUDVANG.Action.ApplyEffects"}}</button>{{/if}}</article>
