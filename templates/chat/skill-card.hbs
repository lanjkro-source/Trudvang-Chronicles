<article class="trudvang chat-card item" data-actor-uuid="{{actor.uuid}}" data-skill-key="{{skillKey}}" data-book-index="{{bookIndex}}">
  <header><i class="fas fa-book-open"></i><div><button type="button" class="card-title" data-action="open-skill-detail">{{name}}</button></div></header>
  <div class="card-flavor shared-description">{{{description}}}</div>
</article>
