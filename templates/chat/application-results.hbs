<section data-application-results>
  <ul class="trait-situation-results application-results" aria-label="{{localize 'TRUDVANG.ChatApplication.Results'}}">
    {{#each rows}}
    <li class="trait-situation-result application-result{{#if outcomeText}} application-result--resisted{{/if}}">
      {{#if tokenUuid}}<button type="button" class="trait-situation-token" data-action="locate-trait-situation-token" data-token-uuid="{{tokenUuid}}" title="{{localize 'TRUDVANG.Dialog.TraitSituationTokenHint'}}">{{label}}</button>{{else}}<span class="trait-situation-token-name">{{label}}</span>{{/if}}
      {{#if outcomeText}}<strong class="test-outcome {{outcomeClass}}">{{outcomeText}}</strong>{{/if}}
      <i class="fas {{icon}}" aria-hidden="true"></i>
      <strong title="{{calculation}}">{{result}}</strong>
      {{#if relicHitText}}<small class="impact-test-result">{{relicHitText}}</small>{{/if}}
      {{#if impactPending}}<button type="button" class="impact-test-button" data-action="resist-impact" data-target-actor-uuid="{{actorUuid}}">{{localize "TRUDVANG.Impact.Resist"}}</button>{{/if}}
      {{#if impactText}}<small class="impact-test-result">{{impactText}}</small>{{/if}}
    </li>
    {{/each}}
  </ul>
</section>
