<article class="trudvang chat-card fear"><header><img src="{{actorImg}}"><div><strong>{{actorName}}</strong><h3>{{#if title}}{{title}}{{else}}{{localize "TRUDVANG.Field.FearFactor"}}{{/if}}</h3></div></header>{{#if resultOnly}}<div class="damage-result">{{total}}</div>{{else}}<button type="button" class="damage-result roll-detail-toggle" data-action="toggle-roll-details" aria-expanded="false" title="{{localize 'TRUDVANG.Action.ShowDetails'}}">{{total}}</button><div class="card-flavor roll-details is-collapsed" data-roll-details hidden><p>{{factor}} : {{detail}}</p>{{#if modifierDetails}}<ul class="damage-modifier-details">{{#each modifierDetails}}<li>{{this}}</li>{{/each}}</ul>{{/if}}</div>{{/if}}{{#if fearArea}}<button type="button" data-action="apply-fear-batch" data-fear="{{total}}" disabled><i class="fas fa-face-flushed" aria-hidden="true"></i> <span>{{localize "TRUDVANG.MagicFear.ApplyBatch"}}</span></button>{{{fearTargetsHTML}}}{{else}}<button type="button" data-action="apply-fear" data-fear="{{total}}"><i class="fas fa-face-flushed"></i> {{localize "TRUDVANG.Fear.ApplyToTargets"}}</button>{{/if}}</article>
