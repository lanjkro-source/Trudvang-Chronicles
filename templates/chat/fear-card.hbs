<article class="trudvang chat-card fear"><header><img src="{{actorImg}}"><div><strong>{{actorName}}</strong><h3>{{localize "TRUDVANG.Field.FearFactor"}}</h3></div></header><button type="button" class="damage-result roll-detail-toggle" data-action="toggle-roll-details" aria-expanded="false" title="{{localize 'TRUDVANG.Action.ShowDetails'}}">{{total}}</button><div class="card-flavor roll-details is-collapsed" data-roll-details hidden><p>{{factor}} : {{detail}}</p>{{#if modifierDetails}}<ul class="damage-modifier-details">{{#each modifierDetails}}<li>{{this}}</li>{{/each}}</ul>{{/if}}</div><button type="button" data-action="apply-fear" data-fear="{{total}}"><i class="fas fa-face-flushed"></i> {{localize "TRUDVANG.Fear.ApplyToTargets"}}</button></article>
