<article class="trudvang chat-card damage"><header><img src="{{itemImg}}"><div><strong>{{actorName}}</strong><h3>{{itemName}}</h3></div></header>{{{qualificationHTML}}}<div class="damage-result">{{total}}{{#each conditionalDamage}} <small>(+{{damage}} vs {{displayTag}}{{#if ../conditionalLongRange}} · {{localize "TRUDVANG.DamageRoll.BeforeHalving"}}{{/if}})</small>{{/each}}</div>{{#if alternatives}}<div class="damage-alternatives">{{#each alternatives}}<button type="button" data-action="apply-damage" data-target-actor-uuid="{{actorUuid}}" data-damage-variant="{{id}}">{{amount}} ({{label}})</button>{{/each}}</div>{{/if}}{{#if damageResistance}}<section data-damage-resistance><button type="button" data-action="resist-damage" data-target-actor-uuid="{{damageResistance.actorUuid}}">{{damageResistance.label}}</button><span data-damage-resistance-result></span></section>{{/if}}<p>{{detail}}</p>{{#if modifierDetails}}<ul class="damage-modifier-details">{{#each modifierDetails}}<li>{{this}}</li>{{/each}}</ul>{{/if}}{{#if openRoll}}<small>{{localize "TRUDVANG.Roll.OpenRoll"}} {{openRoll}}-10</small>{{/if}}{{{targetsHTML}}}</article>
