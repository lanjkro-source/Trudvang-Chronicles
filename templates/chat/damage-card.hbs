<article class="trudvang chat-card damage"><header><img src="{{itemImg}}"><div><strong>{{actorName}}</strong><h3>{{itemName}}</h3></div></header><div class="damage-result">{{total}}</div><p>{{detail}}{{#if strength}} + {{strength}} {{localize "TRUDVANG.Trait.Strength"}}{{/if}}</p>{{#if openRoll}}<small>{{localize "TRUDVANG.Roll.OpenRoll"}} {{openRoll}}-10</small>{{/if}}</article>
