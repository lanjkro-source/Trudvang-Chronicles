<article class="trudvang chat-card damage"><header><img src="{{itemImg}}"><div><strong>{{actorName}}</strong><h3>{{itemName}}</h3></div></header><div class="damage-result">{{total}}</div><p>{{detail}}</p>{{#if modifierDetails}}<ul class="damage-modifier-details">{{#each modifierDetails}}<li>{{this}}</li>{{/each}}</ul>{{/if}}{{#if openRoll}}<small>{{localize "TRUDVANG.Roll.OpenRoll"}} {{openRoll}}-10</small>{{/if}}{{#if targets}}<section class="damage-targets"><h4>{{localize "TRUDVANG.Damage.Targets"}}</h4>{{#each targets}}<div class="damage-target"><img src="{{img}}"><span>{{name}}</span><button type="button" data-action="apply-damage" data-target-actor-uuid="{{actorUuid}}" data-damage="{{../total}}" title="{{localize 'TRUDVANG.Damage.Apply'}}"><i class="fas fa-heart-crack"></i></button><button type="button" data-action="apply-damage" data-ignore-armor="true" data-target-actor-uuid="{{actorUuid}}" data-damage="{{../total}}" title="{{localize 'TRUDVANG.Damage.ApplyIgnoringArmor'}}"><i class="fas fa-burst"></i></button><button type="button" data-action="apply-defense-damage" data-target-item-uuid="{{defenseItemUuid}}" data-damage="{{../total}}" title="{{#if defenseItemName}}{{localize 'TRUDVANG.Damage.ApplyToDefense' item=defenseItemName}}{{else}}{{localize 'TRUDVANG.Damage.NoDefenseItem'}}{{/if}}" {{#unless defenseItemUuid}}disabled{{/unless}}><i class="fas fa-shield"></i></button></div>{{/each}}</section>{{/if}}</article>
