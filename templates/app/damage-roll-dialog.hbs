<div class="trudvang roll-dialog damage-roll-dialog">
  <div class="damage-roll-fields">
    {{#if parsed}}<label>{{localize "TRUDVANG.DamageRoll.DiceCount"}}<span><input type="number" name="damage-dice" value="{{parsed.dice}}" min="1" max="100" step="1" required><b>d{{parsed.faces}}</b></span></label>
    {{else}}<label>{{localize "TRUDVANG.DamageRoll.Formula"}}<input type="text" name="damage-formula" value="{{formula}}" required></label>{{/if}}
    {{#if parsed}}<label>{{localize "TRUDVANG.Field.OpenRoll"}}<input type="number" name="damage-open-roll" value="{{openRoll}}" min="0" max="10" step="1" required></label>{{/if}}
  </div>
  {{#unless parsed}}<p class="damage-roll-hint">{{localize "TRUDVANG.DamageRoll.ComplexFormula"}}</p>{{/unless}}
  {{#if rows}}<ul class="damage-roll-breakdown">{{#each rows}}<li><span>{{label}}{{#if source}}<small>{{source}}</small>{{/if}}</span><b>{{value}}</b></li>{{/each}}</ul>{{/if}}
  <div class="form-group"><label>{{localize "TRUDVANG.DamageRoll.Situational"}}</label><input type="number" name="damage-modifier" value="{{situational}}" step="1" required></div>
  {{#if ranged}}<label class="checkbox damage-long-range"><input type="checkbox" name="damage-long-range" {{#if longRange}}checked{{/if}}> {{localize "TRUDVANG.DamageRoll.LongRange"}}</label>{{/if}}
  <div class="damage-roll-preview"><span>{{localize "TRUDVANG.DamageRoll.Calculation"}}</span><strong data-damage-preview></strong></div>
  <p class="damage-roll-hint">{{localize "TRUDVANG.DamageRoll.Order"}}</p>
</div>
