<div class="trudvang-sheet item-sheet">
  <header class="sheet-header compact"><img class="profile-img" src="{{item.img}}" data-edit="img"><div class="identity"><input class="actor-name" name="name" value="{{item.name}}">{{#if system.swedishName}}<p class="tablet-swedish-name" lang="sv">{{system.swedishName}}</p>{{/if}}<p class="item-type">{{#if (or isThuulRune isRunePower)}}{{localize "TRUDVANG.Tablet.ThuulRune"}}{{else if (eq item.type "tablet")}}{{localize (concat "TRUDVANG.Tablet." system.tabletType)}}{{else}}{{localize (concat "TYPES.Item." item.type)}}{{/if}}{{#if tabletReligion}} · {{tabletReligion}}{{/if}}</p></div><button type="button" data-action="roll" class="initiative-button" {{#if isRunePower}}disabled title="{{localize 'TRUDVANG.Power.RuneObjectNeeded'}}"{{/if}}><i class="fas fa-dice-d20"></i><span>{{localize "TRUDVANG.Action.Use"}}</span></button>{{#if (and (eq item.type "ability") (not system.catalogId))}}<button type="button" data-action="delete-item" class="initiative-button" title="{{localize 'TRUDVANG.Action.Delete'}}"><i class="fas fa-trash"></i><span>{{localize "TRUDVANG.Action.Delete"}}</span></button>{{/if}}</header>
  {{#if hasItemTabs}}<nav class="sheet-tabs item-sheet-tabs"><a class="item active" data-tab="details">{{localize "TRUDVANG.Tab.Details"}}</a>{{#if tabletPowerGroups.length}}<a class="item" data-tab="tablet-powers">{{localize "TRUDVANG.Tablet.Powers"}}</a>{{/if}}{{#if hasModifiers}}<a class="item" data-tab="modifiers">{{localize "TRUDVANG.Tab.Modifiers"}}</a>{{/if}}{{#if supportsEffects}}<a class="item" data-tab="effects">{{localize "TRUDVANG.Tab.Effects"}}</a>{{/if}}</nav>{{/if}}
  <div class="item-sheet-body">
  <div class="tab active" data-tab="details">
  <section class="item-fields">
    {{#if equipmentInspection}}<h2 class="item-fields-title">{{localize "TRUDVANG.Inspection.Object"}}</h2>{{/if}}
    {{#if (eq item.type "weapon")}}
      <div class="item-field-row">
        {{#if isThrowingWeapon}}<label>{{localize "TRUDVANG.Field.WeaponType"}}<input value="{{localize 'TRUDVANG.Weapon.Throwing'}}" disabled></label><label>{{localize "TRUDVANG.Field.MeleeWeaponType"}}<select name="system.combatSpecialty"><option value="oneHandedLightWeapons" {{#if (eq weaponType "oneHandedLightWeapons")}}selected{{/if}}>{{localize "TRUDVANG.Knowledge.oneHandedLightWeapons"}}</option><option value="oneHandedHeavyWeapons" {{#if (eq weaponType "oneHandedHeavyWeapons")}}selected{{/if}}>{{localize "TRUDVANG.Knowledge.oneHandedHeavyWeapons"}}</option><option value="twoHandedWeapons" {{#if (eq weaponType "twoHandedWeapons")}}selected{{/if}}>{{localize "TRUDVANG.Knowledge.twoHandedWeapons"}}</option></select></label>{{else}}<label>{{localize "TRUDVANG.Field.WeaponType"}}<select name="system.combatSpecialty"><option value="oneHandedLightWeapons" {{#if (eq weaponType "oneHandedLightWeapons")}}selected{{/if}}>{{localize "TRUDVANG.Knowledge.oneHandedLightWeapons"}}</option><option value="oneHandedHeavyWeapons" {{#if (eq weaponType "oneHandedHeavyWeapons")}}selected{{/if}}>{{localize "TRUDVANG.Knowledge.oneHandedHeavyWeapons"}}</option><option value="twoHandedWeapons" {{#if (eq weaponType "twoHandedWeapons")}}selected{{/if}}>{{localize "TRUDVANG.Knowledge.twoHandedWeapons"}}</option><option value="crossbow" {{#if (eq weaponType "crossbow")}}selected{{/if}}>{{localize "TRUDVANG.Knowledge.crossbow"}}</option><option value="bowsSlings" {{#if (eq weaponType "bowsSlings")}}selected{{/if}}>{{localize "TRUDVANG.Knowledge.bowsSlings"}}</option><option value="natural" {{#if (eq weaponType "natural")}}selected{{/if}}>{{localize "TRUDVANG.Weapon.Natural"}}</option></select></label><span></span>{{/if}}
        {{#if canBeThrown}}<label class="checkbox"><input name="system.isThrowingWeapon" type="checkbox" {{checked system.isThrowingWeapon}}> {{localize "TRUDVANG.Field.ThrowingWeapon"}}</label>{{else}}<span></span>{{/if}}
      </div>
      <div class="item-field-row"><label>{{localize "TRUDVANG.Field.Weight"}}<input name="system.weight" type="number" step="0.1" value="{{system.weight}}"></label><label>{{localize "TRUDVANG.Field.Value"}}<input name="system.value" type="number" step="0.1" value="{{system.value}}"></label><span></span></div>
      <div class="item-field-row">
        <label>{{localize "TRUDVANG.Field.BonusCpLabel"}}<input name="system.combatPointBonus" type="number" value="{{system.combatPointBonus}}"></label>
        <div class="damage-complex"><label>{{localize "TRUDVANG.Field.Damage"}}<div class="damage-parts"><input class="damage-dice" name="system.damage" value="{{system.damage}}" placeholder="1d10"><span class="damage-open">{{localize "TRUDVANG.Field.OpenRollShort"}}</span><input class="damage-seuil" name="system.openRoll" type="number" min="0" max="10" value="{{system.openRoll}}" title="{{localize 'TRUDVANG.Field.OpenRoll'}}"><span class="damage-plus">+</span><input class="damage-bonus" name="system.damageBonus" type="number" value="{{system.damageBonus}}" title="{{signed system.damageBonus}}"></div></label></div>
        <span></span>
      </div>
      {{#if isThrowingWeapon}}<div class="item-field-row">
        <label>{{localize "TRUDVANG.Field.RangeShort"}}<div class="range-parts"><input value="{{throwingRange.short}}" disabled><span class="unit-suffix">m</span></div></label>
        <label>{{localize "TRUDVANG.Field.RangeLong"}}<div class="range-parts"><input value="{{throwingRange.long}}" disabled><span class="unit-suffix">m</span></div></label><span></span>
      </div>{{else if isRangedWeapon}}<div class="item-field-row">
        <label>{{localize "TRUDVANG.Field.RangeShort"}}<div class="range-parts"><input name="system.range.short" value="{{system.range.short}}" placeholder="50"><span class="unit-suffix">m</span></div></label>
        <label>{{localize "TRUDVANG.Field.RangeLong"}}<div class="range-parts"><input name="system.range.long" value="{{system.range.long}}" placeholder="110"><span class="unit-suffix">m</span></div></label><span></span>
      </div>{{/if}}
      <div class="item-field-row">
        <label>{{localize "TRUDVANG.Field.WeaponActions"}}<input name="system.weaponActions" type="number" value="{{system.weaponActions}}"></label>
        <label>{{localize "TRUDVANG.Field.InitiativeModifier"}}<input name="system.initiativeModifier" type="number" value="{{system.initiativeModifier}}"></label>
        {{#if usesSeparateHands}}<label>{{localize "TRUDVANG.Field.Hand"}}<select name="system.hand"><option value="weapon" {{#if (eq system.hand "weapon")}}selected{{/if}}>{{localize "TRUDVANG.Hand.Weapon"}}</option><option value="offHand" {{#if (eq system.hand "offHand")}}selected{{/if}}>{{localize "TRUDVANG.Hand.Shield"}}</option></select></label>{{else}}<span></span>{{/if}}
      </div>
      <div class="item-field-row">
        <label>{{localize "TRUDVANG.Field.VpProtectionLabel"}}<input value="{{system.protection}}" disabled></label>
        <label>{{localize "TRUDVANG.Field.VpIntegrityLabel"}}<span class="split-input"><input name="system.breach.value" type="number" min="0" value="{{system.breach.value}}"><input name="system.breach.max" type="number" min="0" value="{{system.breach.max}}"></span></label><span></span>
      </div>
    {{/if}}

    {{#if (eq item.type "shield")}}
      <div class="item-field-row"><label>{{localize "TRUDVANG.Field.Weight"}}<input name="system.weight" type="number" step="0.1" value="{{system.weight}}"></label><label>{{localize "TRUDVANG.Field.Value"}}<input name="system.value" type="number" step="0.1" value="{{system.value}}"></label><span></span></div>
      <div class="item-field-row"><label>{{localize "TRUDVANG.Field.BonusCpLabel"}}<input name="system.combatPointBonus" type="number" value="{{system.combatPointBonus}}"></label><div class="damage-complex"><label>{{localize "TRUDVANG.Field.Damage"}}<div class="damage-parts"><input class="damage-dice" name="system.damage" value="{{system.damage}}" placeholder="1d10"><span class="damage-open">{{localize "TRUDVANG.Field.OpenRollShort"}}</span><input class="damage-seuil" name="system.openRoll" type="number" min="0" max="10" value="{{system.openRoll}}" title="{{localize 'TRUDVANG.Field.OpenRoll'}}"><span class="damage-plus">+</span><input class="damage-bonus" name="system.damageBonus" type="number" value="{{system.damageBonus}}" title="{{signed system.damageBonus}}"></div></label></div><span></span></div>
      <div class="item-field-row"><label>{{localize "TRUDVANG.Field.WeaponActions"}}<input name="system.weaponActions" type="number" value="{{system.weaponActions}}"></label><label>{{localize "TRUDVANG.Field.InitiativeModifier"}}<input name="system.initiativeModifier" type="number" value="{{system.initiativeModifier}}"></label><span></span></div>
      <div class="item-field-row"><label>{{localize "TRUDVANG.Field.VpProtectionLabel"}}<input value="{{system.protection}}" disabled></label><label>{{localize "TRUDVANG.Field.VpIntegrityLabel"}}<span class="split-input"><input name="system.breach.value" type="number" min="0" value="{{system.breach.value}}"><input name="system.breach.max" type="number" min="0" value="{{system.breach.max}}"></span></label><label>{{localize "TRUDVANG.Field.PassiveProtection"}}<input name="system.passiveProtection" type="number" min="0" value="{{system.passiveProtection}}"></label></div>
    {{/if}}

    {{#if (eq item.type "armor")}}
      <div class="item-field-row"><label>{{localize "TRUDVANG.Field.Weight"}}<input name="system.weight" type="number" step="0.1" value="{{system.weight}}"></label><label>{{localize "TRUDVANG.Field.Value"}}<input name="system.value" type="number" step="0.1" value="{{system.value}}"></label><label class="checkbox"><input name="system.equipped" type="checkbox" {{checked system.equipped}}> {{localize "TRUDVANG.Field.Equipped"}}</label></div>
      <div class="item-field-row"><label>{{localize "TRUDVANG.Field.Heft"}}<input name="system.heft" type="number" min="0" max="10" value="{{system.heft}}"></label><label>{{localize "TRUDVANG.Field.InitiativeModifier"}}<input name="system.initiativeModifier" value="{{system.initiativeModifier}}" disabled></label><label>{{localize "TRUDVANG.Field.MovementModifier"}}<input name="system.movementModifier" value="{{system.movementModifier}}" disabled></label></div>
      <div class="item-field-row"><label>{{localize "TRUDVANG.Field.VpProtectionLabel"}}<input value="{{system.protection}}" disabled></label><label>{{localize "TRUDVANG.Field.VpIntegrityLabel"}}<span class="split-input"><input name="system.breach.value" type="number" min="0" value="{{system.breach.value}}"><input name="system.breach.max" type="number" min="0" value="{{system.breach.max}}"></span></label><span></span></div>
    {{/if}}

    {{#if (eq item.type "gear")}}<div class="item-field-row"><label>{{localize "TRUDVANG.Field.Weight"}}<input name="system.weight" type="number" step="0.1" value="{{system.weight}}"></label><label>{{localize "TRUDVANG.Field.Value"}}<input name="system.value" type="number" step="0.1" value="{{system.value}}"></label><label class="checkbox"><input name="system.equipped" type="checkbox" {{checked system.equipped}}> {{localize "TRUDVANG.Field.Equipped"}}</label></div>{{/if}}
    {{#if (eq item.type "potion")}}
      <div class="item-field-row"><label>{{localize "TRUDVANG.Field.Weight"}}<input name="system.weight" type="number" step="0.1" value="{{system.weight}}"></label><label>{{localize "TRUDVANG.Field.Value"}}<input name="system.value" type="number" step="0.1" value="{{system.value}}"></label><span></span></div>
      <div class="item-field-row"><label>{{localize "TRUDVANG.Field.PotionType"}}<input name="system.application" value="{{system.application}}"></label><label>{{localize "TRUDVANG.Field.Strength"}}<input name="system.strength" type="number" value="{{system.strength}}"></label><label>{{localize "TRUDVANG.Field.Duration"}}<input name="system.duration" value="{{system.duration}}"></label></div>
      <div class="item-field-row"><label class="wide">{{localize "TRUDVANG.Field.Effect"}}<textarea name="system.effect" class="potion-auto-size" data-max-height="58" rows="1">{{system.effect}}</textarea></label></div>
    {{/if}}

    {{#if isMagicPower}}
      <div class="item-field-row"><label>{{localize "TRUDVANG.Field.Level"}}<input name="system.level" type="number" min="1" max="5" value="{{system.level}}"></label>{{#unless isRunePower}}<label>{{localize "TRUDVANG.Field.Cost"}}<input name="system.cost" type="number" min="0" value="{{system.cost}}"></label>{{else}}<label>{{localize "TRUDVANG.Power.DailyActivation"}}<input name="system.dailyActivation" value="{{system.dailyActivation}}"></label>{{/unless}}<label>{{localize "TRUDVANG.Field.Modifier"}}<input name="system.modifier" type="number" value="{{system.modifier}}"></label></div>
      <div class="item-field-row"><label>{{localize "TRUDVANG.Field.Tablet"}}<input name="system.tablet" value="{{system.tablet}}"></label><label>{{localize "TRUDVANG.Power.Type"}}<select name="system.spellType"><option value="instant" {{#if (eq system.spellType "instant")}}selected{{/if}}>{{localize "TRUDVANG.Power.TypeInstant"}}</option><option value="lasting" {{#if (eq system.spellType "lasting")}}selected{{/if}}>{{localize "TRUDVANG.Power.TypeLasting"}}</option><option value="sustained" {{#if (eq system.spellType "sustained")}}selected{{/if}}>{{localize "TRUDVANG.Power.TypeSustained"}}</option><option value="permanent" {{#if (eq system.spellType "permanent")}}selected{{/if}}>{{localize "TRUDVANG.Power.TypePermanent"}}</option></select></label><label>{{localize "TRUDVANG.Field.Range"}}<input name="system.range" value="{{system.range}}"></label></div>
      <div class="item-field-row"><label>{{localize "TRUDVANG.Field.Duration"}}<input name="system.duration" value="{{system.duration}}"></label><label>{{localize "TRUDVANG.Field.WeavingTime"}}<input name="system.weavingTime" value="{{system.weavingTime}}"></label><span></span></div>
      {{#if activeSpellSummary}}<p class="active-spell-summary">{{activeSpellSummary}}</p>{{/if}}
    {{/if}}
    {{#if (eq item.type "tablet")}}<div class="item-field-row">{{#if isEmbeddedTablet}}<label>{{localize "TRUDVANG.Field.Level"}}<input name="system.level" type="number" min="1" max="5" value="{{system.level}}"></label>{{else}}<span class="tablet-catalog-label">{{localize "TRUDVANG.Tablet.CatalogEntry"}}</span>{{/if}}<label>{{localize "TRUDVANG.Field.TabletType"}}<select name="system.tabletType"><option value="vitner" {{#if (eq system.tabletType "vitner")}}selected{{/if}}>{{localize "TRUDVANG.Tablet.vitner"}}</option><option value="holy" {{#if (eq system.tabletType "holy")}}selected{{/if}}>{{localize "TRUDVANG.Tablet.holy"}}</option></select></label><label>{{localize "TRUDVANG.Field.CostTrait"}}<select name="system.costTrait"><option value="">{{localize "TRUDVANG.Field.Automatic"}}</option>{{selectOptions config.traits selected=system.costTrait localize=true}}</select></label></div>{{#if (eq system.tabletType "holy")}}<div class="item-field-row"><label>{{localize "TRUDVANG.Tablet.Religion"}}<select name="system.religion"><option value="">{{localize "TRUDVANG.Field.Automatic"}}</option>{{#each tabletReligionOptions as |option|}}<option value="{{option.id}}" {{#if option.selected}}selected{{/if}}>{{option.label}}</option>{{/each}}</select></label><span></span><span></span></div>{{/if}}{{/if}}
    {{#if (eq item.type "ability")}}<div class="item-field-row flowing"><label>{{localize "TRUDVANG.Field.AbilityKind"}}<select name="system.kind"><option value="discipline" {{#if (eq system.kind "discipline")}}selected{{/if}}>{{localize "TRUDVANG.AbilityKind.discipline"}}</option><option value="specialty" {{#if (eq system.kind "specialty")}}selected{{/if}}>{{localize "TRUDVANG.AbilityKind.specialty"}}</option><option value="feat" {{#if (eq system.kind "feat")}}selected{{/if}}>{{localize "TRUDVANG.AbilityKind.feat"}}</option></select></label><label>{{localize "TRUDVANG.Field.ParentSkill"}}<select name="system.parentSkill">{{selectOptions config.skills selected=system.parentSkill localize=true}}</select></label><label>{{localize "TRUDVANG.Field.ParentDiscipline"}}<input name="system.parentDiscipline" value="{{system.parentDiscipline}}"></label><label>{{localize "TRUDVANG.Field.Level"}}<input name="system.level" type="number" min="1" max="5" value="{{system.level}}"></label><label>{{localize "TRUDVANG.Field.RollBonus"}}<input name="system.rollBonus" type="number" value="{{system.rollBonus}}"></label><label>{{localize "TRUDVANG.Field.CostTrait"}}<select name="system.costTrait"><option value="">{{localize "TRUDVANG.Field.Automatic"}}</option>{{selectOptions config.traits selected=system.costTrait localize=true}}</select></label></div>{{/if}}
  </section>
  {{#if (or (eq item.type "tablet") isMagicPower)}}
    <div class="tablet-summary-text" title="{{system.summary}}"><textarea name="system.summary" rows="2" aria-label="{{localize 'TRUDVANG.Field.Summary'}}">{{system.summary}}</textarea></div>
    {{#if (eq system.tabletType "vitner")}}<section class="panel tablet-affinity-panel"><h2>{{localize "TRUDVANG.Tablet.Affinity"}}</h2><div class="tablet-affinity-grid">{{#each tabletAffinities as |affinity|}}<label class="tablet-affinity-chip {{affinity.state}}" title="{{affinity.label}} — {{affinity.detail}}"><span>{{affinity.short}}</span><select name="system.affinity.{{affinity.type}}" aria-label="{{affinity.label}}" title="{{affinity.detail}}">{{#each affinity.options as |option|}}<option value="{{option.value}}" {{#if option.selected}}selected{{/if}}>{{option.label}}</option>{{/each}}</select></label>{{/each}}</div></section>
    {{/if}}
  {{/if}}
  {{#if (eq item.type "ability")}}<section class="panel summary-panel"><h2>{{localize "TRUDVANG.Field.Summary"}}</h2><textarea name="system.summary" rows="3">{{system.summary}}</textarea></section>{{/if}}
  {{#if (eq item.type "potion")}}
    <section class="panel potion-text-panel"><h2>{{localize "TRUDVANG.Field.Appearance"}}</h2><textarea name="system.appearance" class="potion-auto-size" data-max-height="76" rows="1">{{#if system.appearance}}{{system.appearance}}{{else}}{{system.description}}{{/if}}</textarea></section>
    <section class="panel potion-text-panel"><h2>{{localize "TRUDVANG.Field.Preparation"}}</h2><textarea name="system.preparation" class="potion-auto-size" data-max-height="76" rows="1">{{system.preparation}}</textarea></section>
    <section class="panel potion-text-panel"><h2>{{localize "TRUDVANG.Field.Usage"}}</h2><textarea name="system.usage" class="potion-auto-size" data-max-height="76" rows="1">{{system.usage}}</textarea></section>
    <section class="panel potion-efficacy-panel"><h2>{{localize "TRUDVANG.Field.Efficacy"}}</h2><table class="potion-efficacy-table"><thead><tr><th></th><th>{{localize "TRUDVANG.Field.Effect"}}</th></tr></thead><tbody><tr><th scope="row">{{localize "TRUDVANG.Efficacy.Mild"}}</th><td><textarea name="system.efficacy.mild" class="potion-auto-size" data-max-height="52" rows="1">{{system.efficacy.mild}}</textarea></td></tr><tr><th scope="row">{{localize "TRUDVANG.Efficacy.Moderate"}}</th><td><textarea name="system.efficacy.moderate" class="potion-auto-size" data-max-height="52" rows="1">{{system.efficacy.moderate}}</textarea></td></tr><tr><th scope="row">{{localize "TRUDVANG.Efficacy.Strong"}}</th><td><textarea name="system.efficacy.strong" class="potion-auto-size" data-max-height="52" rows="1">{{system.efficacy.strong}}</textarea></td></tr><tr><th scope="row">{{localize "TRUDVANG.Efficacy.Total"}}</th><td><textarea name="system.efficacy.total" class="potion-auto-size" data-max-height="52" rows="1">{{system.efficacy.total}}</textarea></td></tr></tbody></table></section>
  {{else}}
    <section class="panel editor-panel item-description"><h2>{{localize "TRUDVANG.Section.Description"}}</h2>{{#if (and (eq item.type "ability") system.catalogId)}}<div class="trudvang detail-dialog">{{{enrichedDescription}}}</div>{{else}}<div class="editor-container">{{editor enrichedDescription target="system.description" button=true editable=editable}}</div>{{/if}}</section>
  {{/if}}
  {{#if isMagicPower}}<section class="panel power-levels-panel"><div class="section-heading"><h2>{{#if isRunePower}}{{localize "TRUDVANG.Power.RuneLevels"}}{{else}}{{localize "TRUDVANG.Power.Levels"}}{{/if}}</h2><button type="button" data-action="power-level-add" title="{{localize 'TRUDVANG.Action.Add'}}"><i class="fas fa-plus"></i></button></div>{{#if isRunePower}}<p class="rune-preview-note">{{localize "TRUDVANG.Power.RunePreview"}}</p>{{/if}}{{#each powerLevelRows as |powerLevel|}}<div class="power-level-row"><div class="power-level-controls">{{#if @root.isRunePower}}<strong>{{localize "TRUDVANG.Power.Level" level=powerLevel.displayLevel}}</strong>{{else}}<label>{{localize "TRUDVANG.Field.Cost"}}<input name="system.powerLevels.{{@index}}.cost" type="number" min="0" value="{{powerLevel.cost}}"></label><label>{{localize "TRUDVANG.Power.MaxCount"}}<input name="system.powerLevels.{{@index}}.maxCount" type="number" min="1" value="{{powerLevel.maxCount}}" placeholder="∞"></label>{{/if}}<button type="button" data-action="power-level-remove" data-index="{{@index}}" title="{{localize 'TRUDVANG.Action.Delete'}}"><i class="fas fa-trash"></i></button></div><textarea name="system.powerLevels.{{@index}}.effect" rows="2" aria-label="{{localize 'TRUDVANG.Power.Levels'}}">{{powerLevel.effect}}</textarea></div>{{/each}}</section>{{/if}}
  {{#if (and (eq item.type "tablet") (eq system.tabletType "vitner"))}}<section class="panel tablet-negation-panel"><h2>{{localize "TRUDVANG.Tablet.Negation"}}</h2><textarea name="system.negation" rows="8">{{system.negation}}</textarea></section>{{/if}}
  <section class="item-fields item-source"><div class="item-field-row"><label class="wide">{{localize "TRUDVANG.Field.Source"}}<input name="system.source" value="{{system.source}}"></label></div></section>
  </div>
  {{#if tabletPowerGroups.length}}<div class="tab" data-tab="tablet-powers"><section class="panel tablet-power-panel"><h2>{{localize "TRUDVANG.Tablet.Powers"}}</h2>{{#each tabletPowerGroups as |group|}}<section class="tablet-power-group {{#unless group.accessible}}locked{{/unless}}"><h3>{{localize "TRUDVANG.Tablet.LevelGroup" level=group.level}}{{#if @root.isEmbeddedTablet}} · {{#if group.accessible}}{{localize "TRUDVANG.Tablet.Accessible"}}{{else}}{{localize "TRUDVANG.Tablet.Locked"}}{{/if}}{{/if}}</h3><ol>{{#each group.powers as |power|}}<li><button type="button" data-action="tablet-power-open" data-catalog-id="{{power.catalogId}}" title="{{power.summary}}">{{power.name}} <i class="fas fa-arrow-up-right-from-square"></i></button>{{#if power.summary}}<small>{{power.summary}}</small>{{/if}}</li>{{/each}}</ol></section>{{/each}}</section></div>{{/if}}
  {{#if hasModifiers}}<div class="tab" data-tab="modifiers">
    <section class="panel equipment-effective-panel">
      <h2>{{localize "TRUDVANG.Inspection.ForWearer" wearer=equipmentInspection.wearerName}}</h2>
      <div class="equipment-effective-grid">
        {{#each equipmentInspection.stats as |stat|}}<button type="button" class="equipment-effective-stat {{#if stat.modified}}modified {{stat.tone}}{{/if}}" data-action="inspect-equipment-stat" data-stat="{{stat.key}}" title="{{localize 'TRUDVANG.Inspection.ClickForDetails'}}"><span>{{stat.label}}</span><strong>{{stat.comparison}}</strong><i class="fas fa-circle-info"></i></button>{{/each}}
      </div>
    </section>
    <section class="panel wearer-impact-panel">
      <h2>{{localize "TRUDVANG.Inspection.WearerImpacts"}}</h2>
      <div class="wearer-impact-list">{{#each equipmentInspection.impacts as |impact|}}<div class="wearer-impact {{impact.mode}} {{impact.tone}}"><span>{{impact.label}}</span><strong>{{impact.value}}</strong><small>{{impact.modeLabel}}</small></div>{{/each}}{{#each equipmentInspection.effects as |effect|}}<div class="wearer-impact {{effect.mode}} {{effect.tone}}"><span>{{effect.label}}</span><strong>{{effect.value}}</strong><small>{{effect.modeLabel}}</small></div>{{/each}}{{#unless equipmentInspection.impacts.length}}{{#unless equipmentInspection.effects.length}}<p class="empty">{{localize "TRUDVANG.Inspection.NoWearerImpact"}}</p>{{/unless}}{{/unless}}</div>
    </section>
  </div>{{/if}}
  {{#if supportsEffects}}<div class="tab" data-tab="effects">
    <section class="panel effects-panel item-effects">
      <div class="section-heading"><h2>{{localize "TRUDVANG.Section.Effects"}}</h2><span><button type="button" data-action="effect-add"><i class="fas fa-plus"></i></button>{{#if canApplyEffects}}<button type="button" data-action="apply-effects" title="{{localize 'TRUDVANG.Action.ApplyEffects'}}"><i class="fas fa-crosshairs"></i></button>{{/if}}</span></div>
      <ol class="effect-list">{{#each effects as |effect|}}<li class="effect-row {{#if effect.disabled}}inactive{{/if}}" data-effect-id="{{effect.id}}" title="{{effect.summary}}"><img src="{{effect.img}}"><button type="button" class="effect-name" data-action="effect-edit">{{effect.name}}</button><span>{{#if effect.transfer}}{{localize "TRUDVANG.Effect.Transferred"}}{{else}}{{localize "TRUDVANG.Effect.Applied"}}{{/if}}</span><button type="button" data-action="effect-toggle"><i class="fas {{#if effect.disabled}}fa-toggle-off{{else}}fa-toggle-on{{/if}}"></i></button><button type="button" data-action="effect-delete"><i class="fas fa-trash"></i></button></li>{{else}}<li class="empty">{{localize "TRUDVANG.Empty.Effects"}}</li>{{/each}}</ol>
    </section>
  </div>{{/if}}
  </div>
</div>
