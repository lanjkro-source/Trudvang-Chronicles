<div class="trudvang-sheet item-sheet">
  <header class="sheet-header compact"><img class="profile-img" src="{{item.img}}" data-edit="img"><div class="identity"><input class="actor-name" name="name" value="{{item.name}}"><p class="item-type">{{localize (concat "TYPES.Item." item.type)}}</p></div><button type="button" data-action="roll" class="initiative-button"><i class="fas fa-dice-d20"></i><span>{{localize "TRUDVANG.Action.Use"}}</span></button>{{#if (and (eq item.type "ability") (not system.catalogId))}}<button type="button" data-action="delete-item" class="initiative-button" title="{{localize 'TRUDVANG.Action.Delete'}}"><i class="fas fa-trash"></i><span>{{localize "TRUDVANG.Action.Delete"}}</span></button>{{/if}}</header>
  <section class="item-fields">
    {{#if (includes (array "weapon" "armor" "shield") item.type)}}<label>{{localize "TRUDVANG.Field.Weight"}}<input name="system.weight" type="number" step="0.1" value="{{system.weight}}"></label><label>{{localize "TRUDVANG.Field.Value"}}<input name="system.value" type="number" step="0.1" value="{{system.value}}"></label><label class="checkbox"><input name="system.equipped" type="checkbox" {{checked system.equipped}}> {{localize "TRUDVANG.Field.Equipped"}}</label>{{else}}{{#if (includes (array "gear" "potion") item.type)}}<label>{{localize "TRUDVANG.Field.Weight"}}<input name="system.weight" type="number" step="0.1" value="{{system.weight}}"></label><label>{{localize "TRUDVANG.Field.Value"}}<input name="system.value" type="number" step="0.1" value="{{system.value}}"></label>{{#if (eq item.type "gear")}}<label class="checkbox"><input name="system.equipped" type="checkbox" {{checked system.equipped}}> {{localize "TRUDVANG.Field.Equipped"}}</label>{{else}}<span></span>{{/if}}{{/if}}{{/if}}
    {{#if (eq item.type "weapon")}}<label>{{localize "TRUDVANG.Field.Category"}}<select name="system.category"><option value="oneHandedLight" {{#if (eq system.category "oneHandedLight")}}selected{{/if}}>{{localize "TRUDVANG.Weapon.OneHandedLight"}}</option><option value="oneHandedHeavy" {{#if (eq system.category "oneHandedHeavy")}}selected{{/if}}>{{localize "TRUDVANG.Weapon.OneHandedHeavy"}}</option><option value="twoHanded" {{#if (eq system.category "twoHanded")}}selected{{/if}}>{{localize "TRUDVANG.Weapon.TwoHanded"}}</option><option value="ranged" {{#if (eq system.category "ranged")}}selected{{/if}}>{{localize "TRUDVANG.Weapon.Ranged"}}</option><option value="natural" {{#if (eq system.category "natural")}}selected{{/if}}>{{localize "TRUDVANG.Weapon.Natural"}}</option></select></label><div class="damage-complex"><label>{{localize "TRUDVANG.Field.Damage"}}<div class="damage-parts"><input class="damage-dice" name="system.damage" value="{{system.damage}}" placeholder="1d10"><span class="damage-open">{{localize "TRUDVANG.Field.OpenRollShort"}}</span><input class="damage-seuil" name="system.openRoll" type="number" min="0" max="10" value="{{system.openRoll}}" title="{{localize 'TRUDVANG.Field.OpenRoll'}}"><span class="damage-plus">+</span><input class="damage-bonus" name="system.damageBonus" type="number" value="{{system.damageBonus}}" title="{{signed system.damageBonus}}"></div></label></div>
{{#if (and (eq item.type "weapon") (eq system.category "ranged"))}}<label>{{localize "TRUDVANG.Field.RangeShort"}}<div class="range-parts"><input name="system.range.short" value="{{system.range.short}}" placeholder="50"><span class="unit-suffix">m</span></div></label><label>{{localize "TRUDVANG.Field.RangeLong"}}<div class="range-parts"><input name="system.range.long" value="{{system.range.long}}" placeholder="110"><span class="unit-suffix">m</span></div></label><span></span>{{/if}}
      <label>{{localize "TRUDVANG.Field.WeaponActions"}}<input name="system.weaponActions" type="number" value="{{system.weaponActions}}"></label><label>{{localize "TRUDVANG.Field.InitiativeModifier"}}<input name="system.initiativeModifier" type="number" value="{{system.initiativeModifier}}"></label><label>{{localize "TRUDVANG.Field.AttackValue"}}<input name="system.attackValue" type="number" value="{{system.attackValue}}"></label>
      <label>{{localize "TRUDVANG.Field.VpProtectionLabel"}}<input value="{{system.protection}}" disabled></label><label>{{localize "TRUDVANG.Field.VpIntegrityLabel"}}<span class="split-input"><input name="system.breach.value" type="number" min="0" value="{{system.breach.value}}"><input name="system.breach.max" type="number" min="0" value="{{system.breach.max}}"></span></label><span></span>{{/if}}
    {{#if (eq item.type "shield")}}<label>{{localize "TRUDVANG.Field.WeaponActions"}}<input name="system.weaponActions" type="number" value="{{system.weaponActions}}"></label><label>{{localize "TRUDVANG.Field.InitiativeModifier"}}<input name="system.initiativeModifier" type="number" value="{{system.initiativeModifier}}"></label><label>{{localize "TRUDVANG.Field.BonusCpLabel"}}<input name="system.damageBonus" type="number" value="{{system.damageBonus}}" title="{{signed system.damageBonus}}"></label>
      <label>{{localize "TRUDVANG.Field.VpProtectionLabel"}}<input value="{{system.protection}}" disabled></label><label>{{localize "TRUDVANG.Field.VpIntegrityLabel"}}<span class="split-input"><input name="system.breach.value" type="number" min="0" value="{{system.breach.value}}"><input name="system.breach.max" type="number" min="0" value="{{system.breach.max}}"></span></label><label>{{localize "TRUDVANG.Field.PassiveProtection"}}<input name="system.passiveProtection" type="number" min="0" value="{{system.passiveProtection}}"></label>{{/if}}
    {{#if (eq item.type "armor")}}<label>{{localize "TRUDVANG.Field.Heft"}}<input name="system.heft" type="number" min="0" max="10" value="{{system.heft}}"></label><label>{{localize "TRUDVANG.Field.InitiativeModifier"}}<input name="system.initiativeModifier" value="{{system.initiativeModifier}}" disabled></label><label>{{localize "TRUDVANG.Field.MovementModifier"}}<input name="system.movementModifier" value="{{system.movementModifier}}" disabled></label>
      <label>{{localize "TRUDVANG.Field.VpProtectionLabel"}}<input value="{{system.protection}}" disabled></label><label>{{localize "TRUDVANG.Field.VpIntegrityLabel"}}<span class="split-input"><input name="system.breach.value" type="number" min="0" value="{{system.breach.value}}"><input name="system.breach.max" type="number" min="0" value="{{system.breach.max}}"></span></label><span></span>{{/if}}
    {{#if (eq item.type "potion")}}<label>{{localize "TRUDVANG.Field.Strength"}}<input name="system.strength" type="number" value="{{system.strength}}"></label><label>{{localize "TRUDVANG.Field.Application"}}<input name="system.application" value="{{system.application}}"></label><label>{{localize "TRUDVANG.Field.Duration"}}<input name="system.duration" value="{{system.duration}}"></label><label class="wide">{{localize "TRUDVANG.Field.Effect"}}<textarea name="system.effect">{{system.effect}}</textarea></label>{{/if}}
    {{#if (includes (array "spell" "divineFeat") item.type)}}<label>{{localize "TRUDVANG.Field.Level"}}<input name="system.level" type="number" min="1" max="5" value="{{system.level}}"></label><label>{{localize "TRUDVANG.Field.Cost"}}<input name="system.cost" type="number" value="{{system.cost}}"></label><label>{{localize "TRUDVANG.Field.Modifier"}}<input name="system.modifier" type="number" value="{{system.modifier}}"></label><label>{{localize "TRUDVANG.Field.Tablet"}}<input name="system.tablet" value="{{system.tablet}}"></label><label>{{localize "TRUDVANG.Field.Range"}}<input name="system.range" value="{{system.range}}"></label><label>{{localize "TRUDVANG.Field.Duration"}}<input name="system.duration" value="{{system.duration}}"></label><label>{{localize "TRUDVANG.Field.WeavingTime"}}<input name="system.weavingTime" value="{{system.weavingTime}}"></label>{{#if (eq item.type "spell")}}<label class="checkbox"><input name="system.active" type="checkbox" {{checked system.active}}> {{localize "TRUDVANG.Field.ActiveSpell"}}</label><label>{{localize "TRUDVANG.Field.ActiveCost"}}<input name="system.activeCost" type="number" min="0" value="{{system.activeCost}}"></label>{{/if}}<label class="wide">{{localize "TRUDVANG.Field.Effect"}}<textarea name="system.effect">{{system.effect}}</textarea></label>{{/if}}
    {{#if (eq item.type "tablet")}}<label>{{localize "TRUDVANG.Field.Level"}}<input name="system.level" type="number" min="1" max="5" value="{{system.level}}"></label><label>{{localize "TRUDVANG.Field.TabletType"}}<select name="system.tabletType"><option value="vitner" {{#if (eq system.tabletType "vitner")}}selected{{/if}}>{{localize "TRUDVANG.Tablet.vitner"}}</option><option value="holy" {{#if (eq system.tabletType "holy")}}selected{{/if}}>{{localize "TRUDVANG.Tablet.holy"}}</option></select></label>{{/if}}
    {{#if (eq item.type "ability")}}<label>{{localize "TRUDVANG.Field.AbilityKind"}}<select name="system.kind"><option value="discipline" {{#if (eq system.kind "discipline")}}selected{{/if}}>{{localize "TRUDVANG.AbilityKind.discipline"}}</option><option value="specialty" {{#if (eq system.kind "specialty")}}selected{{/if}}>{{localize "TRUDVANG.AbilityKind.specialty"}}</option><option value="feat" {{#if (eq system.kind "feat")}}selected{{/if}}>{{localize "TRUDVANG.AbilityKind.feat"}}</option></select></label><label>{{localize "TRUDVANG.Field.ParentSkill"}}<select name="system.parentSkill">{{selectOptions config.skills selected=system.parentSkill localize=true}}</select></label><label>{{localize "TRUDVANG.Field.ParentDiscipline"}}<input name="system.parentDiscipline" value="{{system.parentDiscipline}}"></label><label>{{localize "TRUDVANG.Field.Level"}}<input name="system.level" type="number" min="1" max="5" value="{{system.level}}"></label><label>{{localize "TRUDVANG.Field.RollBonus"}}<input name="system.rollBonus" type="number" value="{{system.rollBonus}}"></label>{{/if}}
    {{#if (includes (array "ability" "tablet") item.type)}}<label>{{localize "TRUDVANG.Field.CostTrait"}}<select name="system.costTrait"><option value="">{{localize "TRUDVANG.Field.Automatic"}}</option>{{selectOptions config.traits selected=system.costTrait localize=true}}</select></label>{{/if}}
    <label class="wide">{{localize "TRUDVANG.Field.Source"}}<input name="system.source" value="{{system.source}}"></label>
  </section>
  <section class="panel effects-panel item-effects">
    <div class="section-heading"><h2>{{localize "TRUDVANG.Section.Effects"}}</h2><span><button type="button" data-action="effect-add"><i class="fas fa-plus"></i></button>{{#if effects.length}}<button type="button" data-action="apply-effects" title="{{localize 'TRUDVANG.Action.ApplyEffects'}}"><i class="fas fa-crosshairs"></i></button>{{/if}}</span></div>
    <ol class="effect-list">{{#each effects as |effect|}}<li class="effect-row {{#if effect.disabled}}inactive{{/if}}" data-effect-id="{{effect.id}}" title="{{effect.summary}}"><img src="{{effect.img}}"><button type="button" class="effect-name" data-action="effect-edit">{{effect.name}}</button><span>{{#if effect.transfer}}{{localize "TRUDVANG.Effect.Transferred"}}{{else}}{{localize "TRUDVANG.Effect.Applied"}}{{/if}}</span><button type="button" data-action="effect-toggle"><i class="fas {{#if effect.disabled}}fa-toggle-off{{else}}fa-toggle-on{{/if}}"></i></button><button type="button" data-action="effect-delete"><i class="fas fa-trash"></i></button></li>{{else}}<li class="empty">{{localize "TRUDVANG.Empty.Effects"}}</li>{{/each}}</ol>
  </section>
  {{#if (eq item.type "ability")}}<section class="panel summary-panel"><h2>{{localize "TRUDVANG.Field.Summary"}}</h2><textarea name="system.summary" rows="3">{{system.summary}}</textarea></section>{{/if}}
<section class="panel editor-panel item-description"><h2>{{localize "TRUDVANG.Section.Description"}}</h2>{{#if (and (eq item.type "ability") system.catalogId)}}<div class="trudvang detail-dialog">{{{enrichedDescription}}}</div>{{else}}<div class="editor-container">{{editor enrichedDescription target="system.description" button=true editable=editable}}</div>{{/if}}</section>
</div>
