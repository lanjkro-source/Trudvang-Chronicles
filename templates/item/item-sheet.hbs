<form class="trudvang-sheet item-sheet" autocomplete="off">
  <header class="sheet-header compact"><img class="profile-img" src="{{item.img}}" data-edit="img"><div class="identity"><input class="actor-name" name="name" value="{{item.name}}"><p class="item-type">{{localize (concat "TYPES.Item." item.type)}}</p></div><button type="button" data-action="roll" class="initiative-button"><i class="fas fa-dice-d20"></i><span>{{localize "TRUDVANG.Action.Use"}}</span></button>{{#if (and (eq item.type "ability") (not system.catalogId))}}<button type="button" data-action="delete-item" class="initiative-button" title="{{localize 'TRUDVANG.Action.Delete'}}"><i class="fas fa-trash"></i><span>{{localize "TRUDVANG.Action.Delete"}}</span></button>{{/if}}</header>
  <section class="item-fields">
    {{#if (includes (array "weapon" "armor" "shield") item.type)}}<label>{{localize "TRUDVANG.Field.Weight"}}<input name="system.weight" type="number" step="0.1" value="{{system.weight}}"></label><label>{{localize "TRUDVANG.Field.Value"}}<input name="system.value" type="number" step="0.1" value="{{system.value}}"></label><label class="checkbox"><input name="system.equipped" type="checkbox" {{checked system.equipped}}> {{localize "TRUDVANG.Field.Equipped"}}</label>{{else}}{{#if (includes (array "gear" "potion") item.type)}}<label>{{localize "TRUDVANG.Field.Weight"}}<input name="system.weight" type="number" step="0.1" value="{{system.weight}}"></label><label>{{localize "TRUDVANG.Field.Value"}}<input name="system.value" type="number" step="0.1" value="{{system.value}}"></label><span></span>{{/if}}{{/if}}
    {{#if (eq item.type "weapon")}}<label>{{localize "TRUDVANG.Field.Category"}}<select name="system.category"><option value="oneHandedLight" {{#if (eq system.category "oneHandedLight")}}selected{{/if}}>{{localize "TRUDVANG.Weapon.OneHandedLight"}}</option><option value="oneHandedHeavy" {{#if (eq system.category "oneHandedHeavy")}}selected{{/if}}>{{localize "TRUDVANG.Weapon.OneHandedHeavy"}}</option><option value="twoHanded" {{#if (eq system.category "twoHanded")}}selected{{/if}}>{{localize "TRUDVANG.Weapon.TwoHanded"}}</option><option value="ranged" {{#if (eq system.category "ranged")}}selected{{/if}}>{{localize "TRUDVANG.Weapon.Ranged"}}</option><option value="natural" {{#if (eq system.category "natural")}}selected{{/if}}>{{localize "TRUDVANG.Weapon.Natural"}}</option></select></label><div class="damage-complex"><label>{{localize "TRUDVANG.Field.Damage"}}<div class="damage-parts"><input class="damage-dice" name="system.damage" value="{{system.damage}}" placeholder="1d10"><span class="damage-open">{{localize "TRUDVANG.Field.OpenRollShort"}}</span><input class="damage-seuil" name="system.openRoll" type="number" min="0" max="10" value="{{system.openRoll}}" title="{{localize 'TRUDVANG.Field.OpenRoll'}}"><input class="damage-bonus" name="system.damageBonus" type="number" value="{{system.damageBonus}}" title="{{signed system.damageBonus}}"></div></label></div>
      <label>{{localize "TRUDVANG.Field.WeaponActions"}}<input name="system.weaponActions" type="number" value="{{system.weaponActions}}"></label><label>{{localize "TRUDVANG.Field.InitiativeModifier"}}<input name="system.initiativeModifier" type="number" value="{{system.initiativeModifier}}"></label><label>{{localize "TRUDVANG.Field.AttackValue"}}<input name="system.attackValue" type="number" value="{{system.attackValue}}"></label>
      <label>{{localize "TRUDVANG.Field.VpProtectionLabel"}}<input value="{{protectionComputed}}" disabled></label><label>{{localize "TRUDVANG.Field.VpIntegrityLabel"}}<span class="split-input"><input name="system.breach.value" type="number" min="0" value="{{system.breach.value}}"><input name="system.breach.max" type="number" min="0" value="{{system.breach.max}}"></span></label><span></span>{{/if}}
    {{#if (eq item.type "shield")}}<label>{{localize "TRUDVANG.Field.WeaponActions"}}<input name="system.weaponActions" type="number" value="{{system.weaponActions}}"></label><label>{{localize "TRUDVANG.Field.InitiativeModifier"}}<input name="system.initiativeModifier" type="number" value="{{system.initiativeModifier}}"></label><label>{{localize "TRUDVANG.Field.AttackValue"}}<input name="system.attackValue" type="number" value="{{system.attackValue}}"></label>
      <label>{{localize "TRUDVANG.Field.Protection"}}<input name="system.protection" type="number" value="{{system.protection}}"></label><label>{{localize "TRUDVANG.Field.BreachCurrent"}}<input name="system.breach.value" type="number" value="{{system.breach.value}}"></label><label>{{localize "TRUDVANG.Field.BreachMax"}}<input name="system.breach.max" type="number" value="{{system.breach.max}}"></label><label>{{localize "TRUDVANG.Field.PassiveProtection"}}<input name="system.passiveProtection" type="number" min="0" value="{{system.passiveProtection}}"></label>{{/if}}
    {{#if (eq item.type "armor")}}<label>{{localize "TRUDVANG.Field.Heft"}}<input name="system.heft" type="number" value="{{system.heft}}"></label><label>{{localize "TRUDVANG.Field.InitiativeModifier"}}<input name="system.initiativeModifier" type="number" value="{{system.initiativeModifier}}"></label><label>{{localize "TRUDVANG.Field.MovementModifier"}}<input name="system.movementModifier" type="number" value="{{system.movementModifier}}"></label>
      <label>{{localize "TRUDVANG.Field.Protection"}}<input name="system.protection" type="number" value="{{system.protection}}"></label><label>{{localize "TRUDVANG.Field.BreachCurrent"}}<input name="system.breach.value" type="number" value="{{system.breach.value}}"></label><label>{{localize "TRUDVANG.Field.BreachMax"}}<input name="system.breach.max" type="number" value="{{system.breach.max}}"></label>{{/if}}
    {{#if (eq item.type "potion")}}<label>{{localize "TRUDVANG.Field.Strength"}}<input name="system.strength" type="number" value="{{system.strength}}"></label><label>{{localize "TRUDVANG.Field.Application"}}<input name="system.application" value="{{system.application}}"></label><label>{{localize "TRUDVANG.Field.Duration"}}<input name="system.duration" value="{{system.duration}}"></label><label class="wide">{{localize "TRUDVANG.Field.Effect"}}<textarea name="system.effect">{{system.effect}}</textarea></label>{{/if}}
    {{#if (includes (array "spell" "divineFeat") item.type)}}<label>{{localize "TRUDVANG.Field.Level"}}<input name="system.level" type="number" min="1" max="5" value="{{system.level}}"></label><label>{{localize "TRUDVANG.Field.Cost"}}<input name="system.cost" type="number" value="{{system.cost}}"></label><label>{{localize "TRUDVANG.Field.Modifier"}}<input name="system.modifier" type="number" value="{{system.modifier}}"></label><label>{{localize "TRUDVANG.Field.Tablet"}}<input name="system.tablet" value="{{system.tablet}}"></label><label>{{localize "TRUDVANG.Field.Range"}}<input name="system.range" value="{{system.range}}"></label><label>{{localize "TRUDVANG.Field.Duration"}}<input name="system.duration" value="{{system.duration}}"></label><label>{{localize "TRUDVANG.Field.WeavingTime"}}<input name="system.weavingTime" value="{{system.weavingTime}}"></label>{{#if (eq item.type "spell")}}<label class="checkbox"><input name="system.active" type="checkbox" {{checked system.active}}> {{localize "TRUDVANG.Field.ActiveSpell"}}</label><label>{{localize "TRUDVANG.Field.ActiveCost"}}<input name="system.activeCost" type="number" min="0" value="{{system.activeCost}}"></label>{{/if}}<label class="wide">{{localize "TRUDVANG.Field.Effect"}}<textarea name="system.effect">{{system.effect}}</textarea></label>{{/if}}
    {{#if (eq item.type "tablet")}}<label>{{localize "TRUDVANG.Field.Level"}}<input name="system.level" type="number" min="1" max="5" value="{{system.level}}"></label><label>{{localize "TRUDVANG.Field.TabletType"}}<select name="system.tabletType"><option value="vitner" {{#if (eq system.tabletType "vitner")}}selected{{/if}}>{{localize "TRUDVANG.Tablet.vitner"}}</option><option value="holy" {{#if (eq system.tabletType "holy")}}selected{{/if}}>{{localize "TRUDVANG.Tablet.holy"}}</option></select></label>{{/if}}
    {{#if (eq item.type "ability")}}<label>{{localize "TRUDVANG.Field.AbilityKind"}}<select name="system.kind"><option value="discipline" {{#if (eq system.kind "discipline")}}selected{{/if}}>{{localize "TRUDVANG.AbilityKind.discipline"}}</option><option value="specialty" {{#if (eq system.kind "specialty")}}selected{{/if}}>{{localize "TRUDVANG.AbilityKind.specialty"}}</option><option value="feat" {{#if (eq system.kind "feat")}}selected{{/if}}>{{localize "TRUDVANG.AbilityKind.feat"}}</option></select></label><label>{{localize "TRUDVANG.Field.ParentSkill"}}<select name="system.parentSkill">{{selectOptions config.skills selected=system.parentSkill localize=true}}</select></label><label>{{localize "TRUDVANG.Field.ParentDiscipline"}}<input name="system.parentDiscipline" value="{{system.parentDiscipline}}"></label><label>{{localize "TRUDVANG.Field.Level"}}<input name="system.level" type="number" min="1" max="5" value="{{system.level}}"></label><label>{{localize "TRUDVANG.Field.RollBonus"}}<input name="system.rollBonus" type="number" value="{{system.rollBonus}}"></label>{{/if}}
    {{#if (includes (array "ability" "tablet") item.type)}}<label>{{localize "TRUDVANG.Field.CostTrait"}}<select name="system.costTrait"><option value="">{{localize "TRUDVANG.Field.Automatic"}}</option>{{selectOptions config.traits selected=system.costTrait localize=true}}</select></label>{{/if}}
    <label class="wide">{{localize "TRUDVANG.Field.Source"}}<input name="system.source" value="{{system.source}}"></label>
  </section>
  {{#if (eq item.type "ability")}}<section class="panel summary-panel"><h2>{{localize "TRUDVANG.Field.Summary"}}</h2><textarea name="system.summary" rows="3">{{system.summary}}</textarea></section>{{/if}}
<section class="panel editor-panel item-description"><h2>{{localize "TRUDVANG.Section.Description"}}</h2>{{#if (and (eq item.type "ability") system.catalogId)}}<div class="trudvang detail-dialog">{{{enrichedDescription}}}</div>{{else}}<div class="editor-container">{{editor enrichedDescription target="system.description" button=true editable=true owner=true}}</div>{{/if}}</section>
</form>
