<div class="trudvang-sheet item-sheet creature-ability-content">
  <header class="capacity-header"><img src="{{ability.img}}" alt=""><input name="name" value="{{ability.name}}" aria-label="{{localize 'TRUDVANG.Field.Name'}}" {{#unless editable}}readonly{{/unless}}></header>
  <section class="capacity-summary"><label>{{localize "TRUDVANG.Field.Summary"}}<textarea name="flags.trudvang-chronicles.capacitySummary" rows="3" title="{{ability.summary}}" {{#unless editable}}readonly{{/unless}}>{{ability.summary}}</textarea></label></section>
  <section class="capacity-description item-description"><h2>{{localize "TRUDVANG.Section.Description"}}</h2>{{#if editable}}<prose-mirror name="description" value="{{ability.description}}" data-document-uuid="{{document.uuid}}" toggled>{{{enrichedDescription}}}</prose-mirror>{{else}}<div class="editor-content">{{{enrichedDescription}}}</div>{{/if}}</section>
  <section class="capacity-source"><h2>{{localize "TRUDVANG.Field.Source"}}</h2><div><label>{{localize "TRUDVANG.Field.SourceBook"}}<input name="flags.trudvang-chronicles.capacitySource.book" value="{{ability.source.book}}" {{#unless editable}}readonly{{/unless}}></label><label>{{localize "TRUDVANG.Field.SourcePage"}}<input name="flags.trudvang-chronicles.capacitySource.page" type="number" min="1" step="1" value="{{ability.source.page}}" {{#unless editable}}readonly{{/unless}}></label></div></section>
</div>
