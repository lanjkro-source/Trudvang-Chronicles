<div class="trudvang-sheet npc-sheet">
  <header class="sheet-header compact">
    <img class="profile-img" src="{{actor.img}}" alt="{{actor.name}}" {{#if editable}}data-action="manage-portraits" role="button" tabindex="0" title="{{localize 'TRUDVANG.Portrait.ManageMenu'}}"{{else}}title="{{actor.name}}"{{/if}}>
    <div class="identity"><input class="actor-name" name="name" value="{{actor.name}}"><div class="identity-grid"><label>{{localize "TRUDVANG.Field.CreatureType"}}<input name="system.details.creatureType" value="{{system.details.creatureType}}"></label><label>{{localize "TRUDVANG.Field.Size"}}<input name="system.details.size" value="{{system.details.size}}"></label><label>{{localize "TRUDVANG.Field.FearFactor"}}<span class="fear-factor-parts"><button type="button" class="roll-icon fear-factor-roll" data-action="roll-fear-factor" title="{{localize 'TRUDVANG.Action.RollFearFactor'}}"><i class="fas fa-dice-d10"></i></button><input name="trudvang.fearFactorDice" value="{{fearFactor.dice}}d{{fearFactor.faces}}" placeholder="1d10"><span class="fear-open">O</span><input name="trudvang.fearFactorThreshold" type="number" min="0" max="10" value="{{fearFactor.threshold}}" title="{{localize 'TRUDVANG.Field.OpenRoll'}}"></span></label><label>{{localize "TRUDVANG.Field.NaturalArmor"}}<input name="system.details.naturalArmor" type="number" value="{{system.details.naturalArmor}}"></label></div></div>
    <div class="initiative-controls"><button type="button" class="initiative-button" data-action="roll-initiative" title="{{localize 'TRUDVANG.Action.RollInitiative'}}"><i class="fas fa-bolt"></i><strong>{{system.initiative.current}}</strong><span>{{localize "TRUDVANG.Resource.Initiative"}}</span></button><button type="button" class="stat-inspect-button" data-action="inspect-global-stat" data-stat="initiative" title="{{localize 'TRUDVANG.Inspection.Inspect'}}" aria-label="{{localize 'TRUDVANG.Inspection.Inspect'}}"><i class="fas fa-circle-info"></i></button></div>
  </header>
  <section class="resource-bar compact npc-resources">
    <div class="resource body"><span class="npc-health-label">{{localize "TRUDVANG.Resource.Body"}} <button type="button" class="npc-health-roll" data-action="roll-npc-health" title="{{localize 'TRUDVANG.Npc.RollHealth' min=npcHealthRange.min max=npcHealthRange.max}}" aria-label="{{localize 'TRUDVANG.Npc.RollHealth' min=npcHealthRange.min max=npcHealthRange.max}}" {{#unless (and editable npcHealthRange.valid)}}disabled{{/unless}}><i class="fas fa-dice"></i></button></span><span><input name="system.resources.body.value" type="number" value="{{system.resources.body.value}}" aria-label="{{localize 'TRUDVANG.Npc.Current'}}"> / <input name="system.resources.body.max" type="number" value="{{system.resources.body.max}}" aria-label="{{localize 'TRUDVANG.Npc.Initial'}}"></span></div>
    <div class="resource npc-movement"><span>{{localize "TRUDVANG.Resource.Movement"}} <small>{{localize "TRUDVANG.Npc.MovementValues"}}</small></span><div class="npc-movement-list">{{#each npcMovement as |movement|}}<span class="npc-movement-mode">{{#unless @first}}<span class="npc-movement-separator" aria-hidden="true">|</span>{{/unless}}{{movement.mode}} : <strong>{{movement.distance}} / {{movement.max}}</strong></span>{{/each}}</div></div>
  </section>
  <nav class="sheet-tabs tabs" data-group="primary"><a class="item" data-tab="summary">{{localize "TRUDVANG.Tab.Summary"}}</a><a class="item" data-tab="combat">{{localize "TRUDVANG.Tab.Combat"}}</a><a class="item" data-tab="magic">{{localize "TRUDVANG.Npc.MagicTab"}}</a><a class="item" data-tab="equipment">{{localize "TRUDVANG.Tab.Equipment"}}</a><a class="item" data-tab="effects">{{localize "TRUDVANG.Tab.Effects"}}</a><a class="item" data-tab="notes">{{localize "TRUDVANG.Tab.Notes"}}</a></nav>
  <section class="sheet-body">
    <div class="tab summary" data-group="primary" data-tab="summary">
      <section class="panel npc-health-panel" aria-label="{{localize 'TRUDVANG.Section.Status'}}">
        <div class="status-vitals">
          <div class="status-protection">
            <span><strong>{{localize "TRUDVANG.Resource.Protection"}} :</strong> <button type="button" class="inspectable-stat" data-action="inspect-global-stat" data-stat="protection">{{armorStatus.protection}} VP <i class="fas fa-circle-info"></i></button>{{#if armorStatus.naturalProtection}}<small>{{localize "TRUDVANG.Npc.NaturalProtection" value=armorStatus.naturalProtection}}</small>{{/if}}</span>
            <span title="{{localize 'TRUDVANG.Npc.IntegrityHint'}}"><strong>{{localize "TRUDVANG.Resource.Integrity"}} :</strong> {{#if armorStatus.hasIntegrity}}{{armorStatus.integrityCurrent}} / {{armorStatus.integrityMax}} VI{{else}}—{{/if}}</span>
          </div>
          <div class="status-vital health-vital">
            <div class="status-vital-header"><strong>{{localize "TRUDVANG.Resource.Body"}}</strong><span class="status-vital-value">{{healthStatus.current}} / {{healthStatus.max}}</span><span class="status-recovery">{{healthStatus.recovery}}</span></div>
            <div class="vital-meter" role="meter" aria-label="{{localize 'TRUDVANG.Resource.Body'}}" aria-valuemin="0" aria-valuemax="{{healthStatus.max}}" aria-valuenow="{{healthStatus.meterValue}}"><span class="vital-meter-fill" style="width: {{healthStatus.percent}}%"></span>{{#each healthStatus.marks as |mark|}}<i class="vital-meter-mark" style="left: {{mark}}%"></i>{{/each}}</div>
            <p class="status-consequence">{{#if healthStatus.survivalExpired}}<strong class="status-dead"><i class="fas fa-skull-crossbones"></i> {{localize "TRUDVANG.Damage.dead"}}</strong>{{else}}<strong>{{localize (concat "TRUDVANG.Damage." healthStatus.level)}}</strong>{{#if (eq healthStatus.level "dying")}}{{#if healthStatus.survivalStarted}}<span>{{localize "TRUDVANG.Status.LifeSparkCountdown" rounds=healthStatus.survivalRounds}}</span>{{else}}<button type="button" class="status-action" data-action="roll-survival-rounds"><i class="fas fa-hourglass-half"></i> {{localize "TRUDVANG.Action.RollSurvivalRounds"}}</button>{{/if}}{{else}}{{#unless healthStatus.ignoresWounds}}<span>{{healthStatus.consequence}}</span>{{/unless}}{{/if}}{{#if healthStatus.ignoresWounds}}<span>{{localize "TRUDVANG.Npc.DurableConsequence"}}</span>{{/if}}{{/if}}</p>
          </div>
        </div>
      </section>
      <div class="npc-stats-grid">
        <section class="panel npc-traits-panel">
          <div class="section-heading npc-traits-heading"><h2>{{localize "TRUDVANG.Section.CreatureTraits"}}</h2><button type="button" data-action="reset-traits" title="{{localize 'TRUDVANG.Action.ResetTraits'}}"><i class="fas fa-recycle"></i></button></div>
          <div class="npc-trait-grid">
            {{#each traitRows as |trait|}}
            <div class="npc-trait-row {{#if trait.modified}}modified{{/if}}" title="{{trait.tooltip}}">
              <button type="button" data-action="roll-trait" data-trait="{{trait.key}}">{{trait.label}}</button>
              <span class="npc-trait-values"><input class="npc-trait-current {{#if trait.modified}}modified-value{{/if}}" name="system.traitCurrent.{{trait.key}}" type="number" step="1" value="{{trait.value}}" title="{{localize 'TRUDVANG.Npc.Current'}}" aria-label="{{trait.label}} — {{localize 'TRUDVANG.Npc.Current'}}" {{#unless ../editable}}readonly{{/unless}}><strong class="npc-trait-initial" title="{{localize 'TRUDVANG.Npc.Initial'}}" aria-label="{{localize 'TRUDVANG.Npc.Initial'}}">{{signed trait.baseValue}}</strong></span>
            </div>
            {{/each}}
          </div>
        </section>
        <section class="panel npc-skills-panel">
          <h2>{{localize "TRUDVANG.Section.Skills"}}</h2>
          {{#if npcBookSkills.length}}<div class="npc-book-skills">{{#each npcBookSkills as |skill|}}<div class="npc-knowledge-row npc-book-skill kind-{{skill.kind}}"><button type="button" class="npc-knowledge-name" data-action="show-npc-book-skill" data-index="{{skill.index}}" title="{{skill.name}}">{{skill.name}}</button><button type="button" class="npc-knowledge-roll" data-action="roll-npc-book-skill" data-index="{{skill.index}}" title="{{localize 'TRUDVANG.Action.Roll'}}"><i class="fas fa-dice-d20"></i></button><span>{{skill.value}}</span></div>{{/each}}</div>{{/if}}
          <ul class="npc-knowledge-tree">
            {{#each npcSkillTrees as |tree|}}
            <li title="{{tree.label}}">
              {{#if tree.visible}}<div class="npc-knowledge-row npc-skill-root kind-skill"><button type="button" class="npc-knowledge-name" data-action="show-skill-detail" data-skill="{{tree.key}}" title="{{tree.description}}">{{tree.label}}</button><button type="button" class="npc-knowledge-roll" data-action="roll-skill" data-skill="{{tree.key}}" title="{{localize 'TRUDVANG.Action.Roll'}}"><i class="fas fa-dice-d20"></i></button><span>{{tree.level}}</span></div>{{/if}}
              {{#if tree.disciplines.length}}<ul class="npc-skill-branches">
                {{#each tree.disciplines as |discipline|}}
                <li>
                  {{#if discipline.visible}}<div class="npc-knowledge-row kind-discipline" data-item-id="{{discipline.item.id}}"><button type="button" class="npc-knowledge-name" data-action="item-edit" title="{{discipline.calculation}}">{{discipline.item.name}}</button><button type="button" class="npc-knowledge-roll" data-action="item-roll" title="{{localize 'TRUDVANG.Action.Roll'}}"><i class="fas fa-dice-d20"></i></button><span>{{discipline.level}}{{#if discipline.separateHands}} | {{discipline.offHandLevel}}{{/if}}</span></div>{{/if}}
                  {{#if discipline.specialties.length}}<ul class="npc-skill-branches">
                    {{#each discipline.specialties as |specialty|}}
                    <li><div class="npc-knowledge-row kind-specialty" data-item-id="{{specialty.item.id}}"><button type="button" class="npc-knowledge-name" data-action="item-edit" title="{{specialty.calculation}}">{{specialty.item.name}}</button><button type="button" class="npc-knowledge-roll" data-action="item-roll" title="{{localize 'TRUDVANG.Action.Roll'}}"><i class="fas fa-dice-d20"></i></button><span>{{specialty.level}}{{#if specialty.separateHands}} | {{specialty.offHandLevel}}{{/if}}</span></div></li>
                    {{/each}}
                  </ul>{{/if}}
                </li>
                {{/each}}
              </ul>{{/if}}
              {{#each tree.unassigned as |node|}}<div class="npc-knowledge-row kind-{{node.item.system.kind}}" data-item-id="{{node.item.id}}"><button type="button" class="npc-knowledge-name" data-action="item-edit" title="{{node.calculation}}">{{node.item.name}}</button><button type="button" class="npc-knowledge-roll" data-action="item-roll" title="{{localize 'TRUDVANG.Action.Roll'}}"><i class="fas fa-dice-d20"></i></button><span>{{node.level}}</span></div>{{/each}}
            </li>
            {{else}}{{#unless npcBookSkills.length}}<li class="empty">{{localize "TRUDVANG.Npc.NoLearnedSkills"}}</li>{{/unless}}{{/each}}
          </ul>
        </section>
        <section class="panel npc-abilities-panel">
          <h2>{{localize "TRUDVANG.Section.Capacities"}}</h2>
          <ol class="npc-ability-list">
            {{#each npcAbilities as |ability|}}
            <li><button type="button" class="npc-ability-row" data-action="capacity-edit" data-effect-uuid="{{ability.effectUuid}}" title="{{ability.summary}}"><i class="fas {{ability.iconClass}} npc-ability-icon" aria-hidden="true"></i><span>{{ability.name}}</span></button></li>
            {{else}}<li class="empty">{{localize "TRUDVANG.Npc.NoCapacities"}}</li>{{/each}}
          </ol>
        </section>
      </div>
    </div>
    <div class="tab equipment npc-inventory" data-group="primary" data-tab="equipment">
      <p class="npc-inventory-hint">{{#if isToken}}{{localize "TRUDVANG.Npc.TokenInventoryHint"}}{{else}}{{localize "TRUDVANG.Npc.DefaultInventoryHint"}}{{/if}}</p>
      <section class="panel">
        <div class="section-heading"><h2>{{localize "TRUDVANG.Section.Weapons"}}</h2>{{#if editable}}<button type="button" data-action="item-create" data-type="weapon" title="{{localize 'TRUDVANG.Action.Add'}} {{localize 'TYPES.Item.weapon'}}"><i class="fas fa-plus"></i> {{localize "TYPES.Item.weapon"}}</button>{{/if}}</div>
        <ol class="item-list npc-inventory-list">
          {{#each npcEquipment.weapons as |item|}}
          <li class="item" data-item-id="{{item.id}}">
            <img src="{{item.img}}" alt="">
            <input class="qty-input" type="number" min="0" step="1" value="{{item.system.quantity}}" data-item-field="quantity" aria-label="{{localize 'TRUDVANG.Field.Quantity'}}" {{#unless @root.editable}}disabled{{/unless}}><span class="qty-sep">×</span>
            <button type="button" class="item-name" data-action="item-edit" title="{{item.name}} — {{item._shortTitle}}">{{item.name}}{{#if item._inspectionModified}} <span class="inspection-badge">Δ</span>{{/if}}</button>
            <span class="item-detail" title="{{item._hoverTitle}}">{{item._compactDetail}}</span>
            <button type="button" class="equip {{#if item.system.equipped}}active{{/if}}" data-action="item-ready" title="{{#if item.system.equipped}}{{localize 'TRUDVANG.Action.Sheathe'}}{{else}}{{localize 'TRUDVANG.Action.Draw'}}{{/if}}" {{#unless @root.editable}}disabled{{/unless}}><i class="fas fa-hand-fist"></i></button>
            <button type="button" data-action="inspect-item" title="{{localize 'TRUDVANG.Inspection.Inspect'}}"><i class="fas fa-magnifying-glass"></i></button>
            <button type="button" data-action="item-delete" title="{{localize 'TRUDVANG.Action.Delete'}}" {{#unless @root.editable}}disabled{{/unless}}><i class="fas fa-trash"></i></button>
          </li>
          {{else}}<li class="empty">{{localize "TRUDVANG.Npc.NoWeapons"}}</li>{{/each}}
        </ol>
      </section>
      <section class="panel">
        <div class="section-heading"><h2>{{localize "TRUDVANG.Section.Protection"}}</h2>{{#if editable}}<span><button type="button" data-action="item-create" data-type="armor" title="{{localize 'TRUDVANG.Action.Add'}} {{localize 'TYPES.Item.armor'}}"><i class="fas fa-plus"></i> <i class="fas fa-tshirt"></i></button><button type="button" data-action="item-create" data-type="shield" title="{{localize 'TRUDVANG.Action.Add'}} {{localize 'TYPES.Item.shield'}}"><i class="fas fa-plus"></i> <i class="fas fa-shield"></i></button></span>{{/if}}</div>
        <ol class="item-list npc-inventory-list">
          {{#each npcEquipment.protection as |item|}}
          <li class="item" data-item-id="{{item.id}}">
            <img src="{{item.img}}" alt="">
            <input class="qty-input" type="number" min="0" step="1" value="{{item.system.quantity}}" data-item-field="quantity" aria-label="{{localize 'TRUDVANG.Field.Quantity'}}" {{#unless @root.editable}}disabled{{/unless}}><span class="qty-sep">×</span>
            <button type="button" class="item-name" data-action="item-edit" title="{{item.name}} — {{item._shortTitle}}">{{item.name}}{{#if item._inspectionModified}} <span class="inspection-badge">Δ</span>{{/if}}</button>
            <span class="item-detail" title="{{item._hoverTitle}}">{{item._compactDetail}}</span>
            {{#if (eq item.type "shield")}}<button type="button" class="equip {{#if item.system.equipped}}active{{/if}}" data-action="item-ready" title="{{#if item.system.equipped}}{{localize 'TRUDVANG.Action.Sheathe'}}{{else}}{{localize 'TRUDVANG.Action.Draw'}}{{/if}}" {{#unless @root.editable}}disabled{{/unless}}><i class="fas fa-hand-fist"></i></button>{{else}}<button type="button" class="equip {{#if item.system.equipped}}active{{/if}}" data-action="item-equip" title="{{localize 'TRUDVANG.Action.Equip'}}" {{#unless @root.editable}}disabled{{/unless}}><i class="fas fa-tshirt"></i></button>{{/if}}
            <button type="button" data-action="inspect-item" title="{{localize 'TRUDVANG.Inspection.Inspect'}}"><i class="fas fa-magnifying-glass"></i></button>
            <button type="button" data-action="item-delete" title="{{localize 'TRUDVANG.Action.Delete'}}" {{#unless @root.editable}}disabled{{/unless}}><i class="fas fa-trash"></i></button>
          </li>
          {{else}}<li class="empty">{{localize "TRUDVANG.Npc.NoProtection"}}</li>{{/each}}
        </ol>
      </section>
      <section class="panel">
        <div class="section-heading"><h2>{{localize "TRUDVANG.Section.Gear"}}</h2>{{#if editable}}<span><button type="button" data-action="item-create" data-type="gear"><i class="fas fa-plus"></i> {{localize "TYPES.Item.gear"}}</button><button type="button" data-action="item-create" data-type="potion"><i class="fas fa-plus"></i> {{localize "TYPES.Item.potion"}}</button></span>{{/if}}</div>
        <ol class="item-list npc-inventory-list">
          {{#each npcEquipment.equipment as |item|}}
          <li class="item" data-item-id="{{item.id}}">
            <img src="{{item.img}}" alt="">
            <input class="qty-input" type="number" min="0" step="1" value="{{item.system.quantity}}" data-item-field="quantity" aria-label="{{localize 'TRUDVANG.Field.Quantity'}}" {{#unless @root.editable}}disabled{{/unless}}><span class="qty-sep">×</span>
            <button type="button" class="item-name" data-action="item-edit" title="{{item.name}} — {{item._shortTitle}}">{{item.name}}</button>
            <span class="item-detail" title="{{item._hoverTitle}}">{{item._compactDetail}}</span>
            {{#if (eq item.type "gear")}}<button type="button" class="equip {{#if item.system.equipped}}active{{/if}}" data-action="item-equip" title="{{localize 'TRUDVANG.Action.Equip'}}" {{#unless @root.editable}}disabled{{/unless}}><i class="fas fa-suitcase"></i></button>{{/if}}
            {{#unless (eq item.type "gear")}}<button type="button" data-action="item-roll" title="{{localize 'TRUDVANG.Action.Use'}}" {{#unless @root.editable}}disabled{{/unless}}><i class="fas fa-flask" aria-hidden="true"></i></button>{{/unless}}
            <button type="button" data-action="inspect-item" title="{{localize 'TRUDVANG.Inspection.Inspect'}}"><i class="fas fa-magnifying-glass"></i></button>
            <button type="button" data-action="item-delete" title="{{localize 'TRUDVANG.Action.Delete'}}" {{#unless @root.editable}}disabled{{/unless}}><i class="fas fa-trash"></i></button>
          </li>
          {{else}}<li class="empty">{{localize "TRUDVANG.Npc.NoGear"}}</li>{{/each}}
        </ol>
      </section>
    </div>
    <div class="tab combat" data-group="primary" data-tab="combat">
      <section class="panel combat-reserves-panel">
        <div class="section-heading"><h2>{{localize "TRUDVANG.Resource.CombatPools"}}</h2><span><button type="button" data-action="inspect-global-stat" data-stat="combat" title="{{localize 'TRUDVANG.Inspection.Inspect'}}"><i class="fas fa-circle-info"></i></button><button type="button" data-action="reset-combat" {{#unless editable}}disabled{{/unless}}><i class="fas fa-rotate"></i> {{localize "TRUDVANG.Action.ResetCombat"}}</button></span></div>
        <div class="combat-pool-grid" aria-label="{{localize 'TRUDVANG.Resource.CombatPools'}}">
          {{#each combatPools as |pool|}}
          {{#if (eq pool.id "free")}}
          <div class="combat-pool-free" title="{{pool.sourceTitle}}" role="group" aria-label="{{pool.label}}">
            <div class="combat-pool-progress combat-pool-hand {{#unless pool.weaponCurrent}}depleted{{/unless}}" style="--pool-level: {{pool.weaponPercent}}" role="progressbar" aria-label="{{localize 'TRUDVANG.CombatPool.FreeWeapon'}}" aria-valuemin="0" aria-valuenow="{{pool.weaponCurrent}}" aria-valuemax="{{pool.max}}"><span class="combat-pool-fill"></span><span class="combat-pool-name">{{localize "TRUDVANG.CombatPool.FreeWeapon"}} <strong>{{pool.weaponCurrent}}</strong></span><strong class="combat-pool-maximum">{{pool.max}}</strong></div>
            <div class="combat-pool-progress combat-pool-hand {{#unless pool.offHandCurrent}}depleted{{/unless}}" style="--pool-level: {{pool.offHandPercent}}" role="progressbar" aria-label="{{localize 'TRUDVANG.CombatPool.FreeShield'}}" aria-valuemin="0" aria-valuenow="{{pool.offHandCurrent}}" aria-valuemax="{{pool.max}}"><span class="combat-pool-fill"></span><span class="combat-pool-name">{{localize "TRUDVANG.CombatPool.FreeShield"}} <strong>{{pool.offHandCurrent}}</strong></span><strong class="combat-pool-maximum">{{pool.max}}</strong></div>
          </div>
          {{else}}
          <div class="combat-pool-progress {{#unless pool.current}}depleted{{/unless}}" style="--pool-level: {{pool.percent}}" title="{{pool.sourceTitle}}" role="progressbar" aria-label="{{pool.label}}" aria-valuemin="0" aria-valuenow="{{pool.current}}" aria-valuemax="{{pool.max}}"><span class="combat-pool-fill"></span><span class="combat-pool-name">{{pool.label}} <strong>{{pool.current}}</strong></span><strong class="combat-pool-maximum">{{pool.max}}</strong></div>
          {{/if}}
          {{/each}}
        </div>
      </section>
      <section class="panel npc-prepared-panel">
        <div class="section-heading"><h2>{{localize "TRUDVANG.Tab.Actions"}}</h2><strong class="npc-cycle-counter" title="{{localize 'TRUDVANG.Npc.CombatCycleHint'}}"><i class="fas fa-hourglass-half" aria-hidden="true"></i> {{npcCombatCycle.remaining}} / {{npcCombatCycle.max}}</strong></div>
        <ol class="npc-prepared-combinations">
          {{#each npcPreparedActions as |combo|}}
          <li class="npc-prepared-combination">
            {{#each combo.actions as |action|}}
            <button type="button" class="npc-prepared-action {{#if action.used}}used{{/if}}" data-action="npc-prepared-action" data-combo="{{action.comboIndex}}" data-step="{{action.stepIndex}}" title="{{action.tooltip}}" {{#unless (and @root.editable action.canUse)}}disabled{{/unless}}>{{#if action.used}}<i class="fas fa-check" aria-hidden="true"></i>{{/if}}{{localize "TRUDVANG.Npc.PreparedActionLabel" name=action.name points=action.points}}</button>
            {{/each}}
          </li>
          {{else}}<li class="empty">{{localize "TRUDVANG.Npc.NoPreparedActions"}}</li>{{/each}}
        </ol>
      </section>
      <section class="panel">
        <h2>{{localize "TRUDVANG.Section.Weapons"}}</h2>
        <ol class="item-list combat-action-list npc-combat-actions">
          {{#each npcCombatItems as |entry|}}
          <li class="item {{#unless entry.readied}}not-readied{{/unless}} {{#if entry.depleted}}depleted{{/if}}" data-item-id="{{entry.item.id}}">
            <img src="{{entry.item.img}}" alt=""><button type="button" class="item-name" data-action="item-edit" title="{{entry.hoverTitle}}">{{entry.item.name}}</button><span class="item-detail" title="{{entry.hoverTitle}}">{{entry.item._compactDetail}}</span>
            <button type="button" data-action="item-roll" title="{{localize 'TRUDVANG.Action.Attack'}}" {{#unless (and @root.editable entry.readied entry.canUseAction)}}disabled{{/unless}}><i class="fas fa-sword"></i></button>
            <button type="button" data-action="item-parry" title="{{localize 'TRUDVANG.Action.Parry'}}" {{#unless (and @root.editable entry.readied entry.canUseAction)}}disabled{{/unless}}><i class="fas fa-shield"></i></button>
            <button type="button" data-action="item-damage" title="{{localize 'TRUDVANG.Action.Damage'}}" {{#unless @root.editable}}disabled{{/unless}}><i class="fas fa-burst"></i></button>
            <button type="button" class="ready-action {{#if entry.readied}}active{{/if}}" data-action="item-ready" title="{{#if entry.readied}}{{localize 'TRUDVANG.Action.Sheathe'}}{{else}}{{localize 'TRUDVANG.Action.Draw'}}{{/if}}" {{#unless @root.editable}}disabled{{/unless}}><i class="fas {{#if entry.readied}}fa-box-archive{{else}}fa-hand-fist{{/if}}"></i></button>
          </li>
          {{else}}<li class="empty">{{localize "TRUDVANG.Npc.NoWeapons"}}</li>{{/each}}
        </ol>
      </section>
      <section class="panel">
        <div class="section-heading"><h2>{{localize "TRUDVANG.Npc.NaturalWeapons"}}</h2>{{#if editable}}<button type="button" data-action="item-create" data-type="weapon" data-natural="true" title="{{localize 'TRUDVANG.Action.Add'}}"><i class="fas fa-plus"></i></button>{{/if}}</div>
        <ol class="item-list combat-action-list npc-combat-actions">
          {{#each npcNaturalWeapons as |entry|}}
          <li class="item {{#if entry.depleted}}depleted{{/if}}" data-item-id="{{entry.item.id}}">
            <img src="{{entry.item.img}}" alt=""><button type="button" class="item-name" data-action="item-edit" title="{{entry.hoverTitle}}">{{entry.item.name}}</button><span class="item-detail" title="{{entry.hoverTitle}}">{{entry.item._compactDetail}}</span>
            <button type="button" data-action="item-roll" title="{{localize 'TRUDVANG.Action.Attack'}}" {{#unless (and @root.editable entry.canUseAction)}}disabled{{/unless}}><i class="fas fa-hand-fist"></i></button>
            <button type="button" data-action="item-parry" title="{{localize 'TRUDVANG.Action.Parry'}}" {{#unless (and @root.editable entry.canUseAction)}}disabled{{/unless}}><i class="fas fa-shield"></i></button>
            <button type="button" data-action="item-damage" title="{{localize 'TRUDVANG.Action.Damage'}}" {{#unless @root.editable}}disabled{{/unless}}><i class="fas fa-burst"></i></button><span class="icon-placeholder"></span>
          </li>
          {{else}}<li class="empty">{{localize "TRUDVANG.Npc.NoNaturalWeapons"}}</li>{{/each}}
        </ol>
      </section>
      {{#if (or npcWrestling.grapple npcWrestling.glima)}}
      <section class="panel"><ol class="item-list combat-action-list npc-combat-actions">
        {{#if npcWrestling.grapple}}<li class="item natural-action"><img src="icons/svg/net.svg" alt=""><span class="item-name">{{localize "TRUDVANG.Combat.Grapple"}}</span><span class="item-detail">{{localize "TRUDVANG.Combat.WrestlingHint"}}</span><button type="button" data-action="wrestling-action" data-kind="grapple" title="{{localize 'TRUDVANG.Combat.Grapple'}}" {{#unless @root.editable}}disabled{{/unless}}><i class="fas fa-hands-bound"></i></button><span class="icon-placeholder"></span><span class="icon-placeholder"></span><span class="icon-placeholder"></span></li>{{/if}}
        {{#if npcWrestling.glima}}<li class="item natural-action"><img src="icons/svg/falling.svg" alt=""><span class="item-name">{{localize "TRUDVANG.Combat.Glima"}}</span><span class="item-detail">{{localize "TRUDVANG.Combat.WrestlingHint"}}</span><button type="button" data-action="wrestling-action" data-kind="glima" title="{{localize 'TRUDVANG.Combat.Glima'}}" {{#unless @root.editable}}disabled{{/unless}}><i class="fas fa-person-falling"></i></button><span class="icon-placeholder"></span><span class="icon-placeholder"></span><span class="icon-placeholder"></span></li>{{/if}}
      </ol></section>
      {{/if}}
      <section class="panel"><ol class="item-list combat-action-list npc-combat-actions">
        <li class="item natural-action"><img src="icons/svg/wingfoot.svg" alt=""><span class="item-name">{{localize "TRUDVANG.Combat.MovementAction"}}</span><span class="item-detail" title="{{npcMovementHint}}">{{npcMovementHint}}</span><button type="button" data-action="movement-action" title="{{localize 'TRUDVANG.Combat.MovementAction'}}" {{#unless (and editable isInCombat)}}disabled{{/unless}}><i class="fas fa-person-walking"></i></button><span class="icon-placeholder"></span><span class="icon-placeholder"></span><span class="icon-placeholder"></span></li>
        <li class="item generic-action"><img src="icons/svg/d20-grey.svg" alt=""><span class="item-name">{{localize "TRUDVANG.Combat.OtherAction"}}</span><span class="item-detail" title="{{localize 'TRUDVANG.Combat.OtherActionHint'}}">{{localize "TRUDVANG.Combat.OtherActionHint"}}</span><button type="button" data-action="generic-combat-action" title="{{localize 'TRUDVANG.Action.SpendCombat'}}" {{#unless (and editable isInCombat)}}disabled{{/unless}}><i class="fas fa-person"></i></button></li>
      </ol></section>
    </div>
    <div class="tab magic" data-group="primary" data-tab="magic">
      <div class="magic-concentration-row"><button type="button" data-action="roll-concentration" {{#unless editable}}disabled{{/unless}}><i class="fas fa-dice-d20"></i> {{localize "TRUDVANG.Dialog.ConcentrationRoll"}}</button></div>
      {{#if (or npcHasVitner npcHasDivinity)}}<section class="panel npc-magic-resources">
        {{#if npcHasVitner}}
        <div class="npc-magic-resource">
          <label>{{localize "TRUDVANG.Resource.Vitner"}}</label>
          {{#if unlimitedVitner}}<strong title="{{localize 'TRUDVANG.Npc.UnlimitedVitner'}}">∞</strong>{{else}}
          <span><input name="system.resources.vitner.value" type="number" min="0" value="{{system.resources.vitner.value}}" aria-label="{{localize 'TRUDVANG.Resource.Vitner'}} — {{localize 'TRUDVANG.Npc.Current'}}" {{#unless editable}}readonly{{/unless}}> /
            {{#if npcManualVitnerMax}}<input name="system.resources.vitner.max" type="number" min="0" value="{{system.resources.vitner.max}}" aria-label="{{localize 'TRUDVANG.Resource.Vitner'}} — {{localize 'TRUDVANG.Npc.Initial'}}" {{#unless editable}}readonly{{/unless}}>{{else}}<strong>{{system.resources.vitner.max}}</strong>{{/if}}</span>
          <button type="button" data-action="restore-vitner" title="{{localize 'TRUDVANG.Npc.RestoreVitner'}}" {{#unless editable}}disabled{{/unless}}><i class="fas fa-rotate"></i></button>{{/if}}
        </div>
        {{/if}}{{#if npcHasDivinity}}<div class="npc-magic-resource">
          <label>{{localize "TRUDVANG.Resource.Divinity"}}</label>
          <span><input name="system.resources.divinity.value" type="number" min="0" value="{{system.resources.divinity.value}}" aria-label="{{localize 'TRUDVANG.Resource.Divinity'}} — {{localize 'TRUDVANG.Npc.Current'}}" {{#unless editable}}readonly{{/unless}}> /
            {{#if npcManualDivinityMax}}<input name="system.resources.divinity.max" type="number" min="0" value="{{system.resources.divinity.max}}" aria-label="{{localize 'TRUDVANG.Resource.Divinity'}} — {{localize 'TRUDVANG.Npc.Initial'}}" {{#unless editable}}readonly{{/unless}}>{{else}}<strong>{{system.resources.divinity.max}}</strong>{{/if}} +
            <input name="system.resources.divinity.temporary" type="number" min="0" value="{{system.resources.divinity.temporary}}" aria-label="{{localize 'TRUDVANG.Npc.TemporaryDivinity'}}" {{#unless editable}}readonly{{/unless}}></span>
        </div>{{/if}}
        <dl class="status-list">{{#if npcHasVitner}}<dt>{{localize "TRUDVANG.Field.VitnerType"}}</dt><dd>{{#if vitnerProfile}}{{localize vitnerProfile.label}}{{else}}—{{/if}}</dd>{{/if}}{{#if npcHasDivinity}}<dt>{{localize "TRUDVANG.Field.Religion"}}</dt><dd>{{#if religionProfile}}{{localize religionProfile.label}}{{else}}—{{/if}}</dd>{{/if}}</dl>
        {{#if needsInnateMagic}}<label class="npc-innate-magic">{{localize "TRUDVANG.Npc.InnateMagicTargetLabel"}}<input name="system.magic.castingTarget" type="number" value="{{system.magic.castingTarget}}" {{#unless editable}}readonly{{/unless}}></label><p class="hint">{{localize "TRUDVANG.Npc.InnateMagicHint"}}</p>{{/if}}
      </section>{{/if}}
      {{#if hasActiveSpellTracker}}<section class="panel active-spell-panel"><div class="section-heading"><h2>{{localize "TRUDVANG.Section.ActiveSpells"}}</h2><strong>{{localize "TRUDVANG.Field.ActiveSpellsCount" current=activeSpells.length max=activeSpellLimit}}</strong></div><ol class="item-list active-spell-list">{{#each activeSpells as |item|}}<li class="item" data-item-id="{{item.id}}"><img src="{{item.img}}" alt=""><button type="button" class="item-name" data-action="item-edit">{{item.name}}</button><span class="item-detail" title="{{item.duration}}">{{localize "TRUDVANG.Field.ActiveCost"}} {{item.cost}}</span><button type="button" data-action="end-active-spell" data-cast-id="{{item.castId}}" title="{{localize 'TRUDVANG.Action.EndActiveSpell'}}" {{#unless @root.editable}}disabled{{/unless}}><i class="fas fa-xmark"></i></button></li>{{else}}<li class="empty">{{localize "TRUDVANG.Empty.ActiveSpells"}}</li>{{/each}}</ol></section>{{/if}}
      <section class="panel">
        <div class="section-heading"><h2>{{localize "TRUDVANG.Section.Magic"}}</h2><span class="tree-controls"><button type="button" data-action="toggle-inactive-magic" title="{{localize 'TRUDVANG.Action.HideInactiveMagic'}}"><i class="fas fa-eye-slash"></i></button><button type="button" data-action="add-tablet" {{#unless editable}}disabled{{/unless}}><i class="fas fa-plus"></i> {{localize "TRUDVANG.Action.AddTablet"}}</button></span></div>
        <div class="knowledge-tree magic-tree npc-magic-tree">
          {{#each magicTree as |node|}}
          <details class="magic-branch" data-tree-key="tablet:{{node.item.id}}" open>
            <summary><div class="knowledge-node tablet-node" data-item-id="{{node.item.id}}"><button type="button" class="image-toggle" data-action="toggle-tree"><img src="{{node.item.img}}" alt=""></button><button type="button" class="item-name" data-action="item-edit" title="{{node.item.system.summary}}">{{node.item.name}}</button><span>{{localize "TRUDVANG.Field.Level"}} {{node.item.system.level}}</span></div></summary>
            {{#each node.children as |child|}}<div class="knowledge-node spell-node {{#if child.inactive}}inactive-magic{{/if}}" data-item-id="{{child.item.id}}"><i class="fas {{child.iconClass}} power-type-icon" aria-hidden="true"></i><button type="button" class="roll-icon" data-action="item-roll" title="{{#if child.item.system.isRune}}{{localize 'TRUDVANG.Power.RuneObjectNeeded'}}{{else}}{{localize 'TRUDVANG.Action.Roll'}}{{/if}}" {{#if child.item.system.isRune}}disabled{{else}}{{#if child.inactive}}disabled{{else}}{{#unless @root.editable}}disabled{{/unless}}{{/if}}{{/if}}><i class="fas fa-wand-sparkles"></i></button><button type="button" class="item-name" data-action="item-edit" title="{{child.item.system.summary}}">{{child.item.name}}</button><span>{{localize "TRUDVANG.Field.Level"}} {{child.displayLevel}}</span><span class="power-cost">{{#unless child.item.system.isRune}}{{localize "TRUDVANG.Field.Cost"}} {{child.item.system.cost}}{{/unless}}</span></div>{{/each}}
          </details>
          {{/each}}
          {{#if unassignedMagic.length}}<h3>{{localize "TRUDVANG.Field.Unassigned"}}</h3>{{#each unassignedMagic as |power|}}<div class="knowledge-node spell-node orphan" data-item-id="{{power.item.id}}"><i class="fas {{power.iconClass}} power-type-icon" aria-hidden="true"></i><button type="button" class="roll-icon" data-action="item-roll" {{#if power.item.system.isRune}}disabled{{else}}{{#unless @root.editable}}disabled{{/unless}}{{/if}}><i class="fas fa-wand-sparkles"></i></button><button type="button" class="item-name" data-action="item-edit" title="{{power.item.system.summary}}">{{power.item.name}}</button><span>{{localize "TRUDVANG.Field.Level"}} {{power.item.system.level}}</span><span class="power-cost">{{#unless power.item.system.isRune}}{{localize "TRUDVANG.Field.Cost"}} {{power.item.system.cost}}{{/unless}}</span></div>{{/each}}{{else}}{{#unless magicTree.length}}<p class="empty">{{localize "TRUDVANG.Npc.NoMagic"}}</p>{{/unless}}{{/if}}
        </div>
      </section>
    </div>
    <div class="tab effects" data-group="primary" data-tab="effects"><section class="panel effects-panel"><div class="section-heading"><h2>{{localize "TRUDVANG.Section.Effects"}}</h2><span><button type="button" data-action="effect-add"><i class="fas fa-plus"></i> {{localize "TRUDVANG.Action.AddEffect"}}</button></span></div><ol class="effect-list">{{#each effects as |effect|}}<li class="effect-row {{#unless effect.active}}inactive{{/unless}}"><img src="{{effect.img}}"><button type="button" class="effect-name" data-action="effect-edit" data-effect-uuid="{{effect.uuid}}">{{effect.name}}</button><span class="effect-source">{{effect.source}}</span><span class="effect-duration"><i class="fas fa-clock"></i> {{effect.duration}}</span>{{#if effect.canEdit}}<button type="button" data-action="effect-toggle" data-effect-uuid="{{effect.uuid}}"><i class="fas {{#if effect.disabled}}fa-toggle-off{{else}}fa-toggle-on{{/if}}"></i></button><button type="button" data-action="effect-delete" data-effect-uuid="{{effect.uuid}}"><i class="fas fa-trash"></i></button>{{/if}}</li>{{else}}<li class="empty">{{localize "TRUDVANG.Empty.Effects"}}</li>{{/each}}</ol></section></div>
    <div class="tab notes" data-group="primary" data-tab="notes"><section class="panel editor-panel"><h2>{{localize "TRUDVANG.Section.Description"}}</h2>{{editor enriched.description target="system.description" button=true editable=editable}}</section><section class="panel editor-panel"><h2>{{localize "TRUDVANG.Section.Notes"}}</h2>{{editor enriched.notes target="system.notes" button=true editable=editable}}</section></div>
  </section>
</div>
