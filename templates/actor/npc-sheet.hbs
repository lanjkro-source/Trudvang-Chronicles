<div class="trudvang-sheet npc-sheet">
  <header class="sheet-header compact">
    <img class="profile-img" src="{{actor.img}}" data-edit="img" title="{{actor.name}}">
    <div class="identity"><input class="actor-name" name="name" value="{{actor.name}}"><div class="identity-grid"><label>{{localize "TRUDVANG.Field.CreatureType"}}<input name="system.details.creatureType" value="{{system.details.creatureType}}"></label><label>{{localize "TRUDVANG.Field.Size"}}<input name="system.details.size" value="{{system.details.size}}"></label><label>{{localize "TRUDVANG.Field.FearFactor"}}<span class="fear-factor-parts"><button type="button" class="roll-icon fear-factor-roll" data-action="roll-fear-factor" title="{{localize 'TRUDVANG.Action.RollFearFactor'}}"><i class="fas fa-dice-d10"></i></button><input name="trudvang.fearFactorDice" value="{{fearFactor.dice}}d{{fearFactor.faces}}" placeholder="1d10"><span class="fear-open">O</span><input name="trudvang.fearFactorThreshold" type="number" min="0" max="10" value="{{fearFactor.threshold}}" title="{{localize 'TRUDVANG.Field.OpenRoll'}}"></span></label><label>{{localize "TRUDVANG.Field.NaturalArmor"}}<input name="system.details.naturalArmor" type="number" value="{{system.details.naturalArmor}}"></label></div></div>
    <button type="button" class="initiative-button" data-action="roll-initiative"><i class="fas fa-bolt"></i><strong>{{system.initiative.current}}</strong><span>{{localize "TRUDVANG.Resource.Initiative"}}</span></button>
  </header>
  <section class="resource-bar compact"><label class="resource body"><span>{{localize "TRUDVANG.Resource.Body"}}</span><span><input name="system.resources.body.value" type="number" value="{{system.resources.body.value}}"> / <input name="system.resources.body.max" type="number" value="{{system.resources.body.max}}"></span></label><label class="resource"><span>{{localize "TRUDVANG.Resource.Combat"}}</span><span><output>{{system.resources.combat.current}}</output> / {{system.resources.combat.max}}</span><button type="button" data-action="reset-combat"><i class="fas fa-rotate"></i></button></label><label class="resource"><span>{{localize "TRUDVANG.Resource.Movement"}}</span><span><input name="system.movement.base" type="number" value="{{system.movement.base}}"> → {{system.movement.current}}</span></label><label class="resource"><span>{{localize "TRUDVANG.Resource.Protection"}}</span><output>{{system.protection}}</output></label></section>
  <nav class="sheet-tabs tabs" data-group="primary"><a class="item" data-tab="summary">{{localize "TRUDVANG.Tab.Summary"}}</a><a class="item" data-tab="actions">{{localize "TRUDVANG.Tab.Actions"}}</a><a class="item" data-tab="effects">{{localize "TRUDVANG.Tab.Effects"}}</a><a class="item" data-tab="notes">{{localize "TRUDVANG.Tab.Notes"}}</a></nav>
  <section class="sheet-body">
    <div class="tab summary" data-group="primary" data-tab="summary">
      <section class="panel npc-health-panel" aria-label="{{localize 'TRUDVANG.Section.Status'}}">
        <div class="status-vitals">
          <div class="status-protection">
            <span><strong>{{localize "TRUDVANG.Resource.Protection"}} :</strong> <button type="button" class="inspectable-stat" data-action="inspect-global-stat" data-stat="protection">{{armorStatus.protection}} VP <i class="fas fa-circle-info"></i></button>{{#if armorStatus.naturalProtection}}<small>{{localize "TRUDVANG.Npc.NaturalProtection" value=armorStatus.naturalProtection}}</small>{{/if}}</span>
            <span title="{{localize 'TRUDVANG.Npc.IntegrityHint'}}"><strong>{{localize "TRUDVANG.Resource.Integrity"}} :</strong> {{#if armorStatus.hasIntegrity}}{{armorStatus.integrityCurrent}} / {{armorStatus.integrityMax}} VI{{else}}—{{/if}}</span>
          </div>
          <div class="status-vital health-vital">
            <div class="status-vital-header"><strong>{{localize "TRUDVANG.Resource.Body"}}</strong><span class="status-vital-value">{{healthStatus.current}} / {{healthStatus.max}}</span><span class="status-recovery">{{healthStatus.recovery}}</span></div>
            <div class="vital-meter" role="meter" aria-label="{{localize 'TRUDVANG.Resource.Body'}}" aria-valuemin="0" aria-valuemax="{{healthStatus.max}}" aria-valuenow="{{healthStatus.meterValue}}"><span class="vital-meter-fill" style="width: {{healthStatus.percent}}%"></span>{{#each healthStatus.marks as |mark|}}<i class="vital-meter-mark" style="left: {{mark}}%"></i>{{/each}}</div>
            <p class="status-consequence">{{#if healthStatus.survivalExpired}}<strong class="status-dead"><i class="fas fa-skull-crossbones"></i> {{localize "TRUDVANG.Damage.dead"}}</strong>{{else}}<strong>{{localize (concat "TRUDVANG.Damage." healthStatus.level)}}</strong>{{#if (eq healthStatus.level "dying")}}{{#if healthStatus.survivalStarted}}<span>{{localize "TRUDVANG.Status.LifeSparkCountdown" rounds=healthStatus.survivalRounds}}</span>{{else}}<button type="button" class="status-action" data-action="roll-survival-rounds"><i class="fas fa-hourglass-half"></i> {{localize "TRUDVANG.Action.RollSurvivalRounds"}}</button>{{/if}}{{else}}{{#unless healthStatus.ignoresWounds}}<span>{{healthStatus.consequence}}</span>{{/unless}}{{/if}}{{#if healthStatus.ignoresWounds}}<span>{{localize "TRUDVANG.Npc.DurableConsequence"}}</span>{{/if}}{{/if}}</p>
          </div>
        </div>
      </section>
      <div class="npc-stats-grid">
        <section class="panel npc-traits-panel">
          <div class="section-heading npc-traits-heading"><h2>{{localize "TRUDVANG.Section.CreatureTraits"}}</h2><button type="button" data-action="reset-traits" title="{{localize 'TRUDVANG.Action.ResetTraits'}}"><i class="fas fa-recycle"></i></button></div>
          <div class="npc-trait-grid">
            {{#each traitRows as |trait|}}
            <div class="npc-trait-row {{#if trait.modified}}modified{{/if}}" title="{{trait.tooltip}}">
              <button type="button" data-action="roll-trait" data-trait="{{trait.key}}">{{trait.label}}</button>
              <span class="npc-trait-values"><strong class="npc-trait-current {{#if trait.modified}}modified-value{{/if}}" title="{{localize 'TRUDVANG.Npc.Current'}}" aria-label="{{localize 'TRUDVANG.Npc.Current'}}">{{signed trait.value}}</strong><strong class="npc-trait-initial" title="{{localize 'TRUDVANG.Npc.Initial'}}" aria-label="{{localize 'TRUDVANG.Npc.Initial'}}">{{signed trait.baseValue}}</strong></span>
            </div>
            {{/each}}
          </div>
        </section>
        <section class="panel npc-skills-panel">
          <h2>{{localize "TRUDVANG.Section.Skills"}}</h2>
          {{#if npcBookSkills.length}}<div class="npc-book-skills">{{#each npcBookSkills as |skill|}}<button type="button" class="npc-knowledge-row npc-book-skill kind-{{skill.kind}}" data-action="show-npc-book-skill" data-index="{{skill.index}}" title="{{skill.name}}"><span>{{skill.name}}</span><span>{{skill.value}}</span></button>{{/each}}</div>{{/if}}
          <ul class="npc-knowledge-tree">
            {{#each npcSkillTrees as |tree|}}
            <li title="{{tree.label}}">
              {{#if tree.visible}}<button type="button" class="npc-knowledge-row npc-skill-root kind-skill" data-action="show-skill-detail" data-skill="{{tree.key}}" title="{{tree.description}}"><span>{{tree.label}}</span><span>{{tree.level}}</span></button>{{/if}}
              {{#if tree.disciplines.length}}<ul class="npc-skill-branches">
                {{#each tree.disciplines as |discipline|}}
                <li>
                  {{#if discipline.visible}}<button type="button" class="npc-knowledge-row kind-discipline" data-item-id="{{discipline.item.id}}" data-action="item-edit" title="{{discipline.calculation}}"><span>{{discipline.item.name}}</span><span>{{discipline.level}}{{#if discipline.separateHands}} | {{discipline.offHandLevel}}{{/if}}</span></button>{{/if}}
                  {{#if discipline.specialties.length}}<ul class="npc-skill-branches">
                    {{#each discipline.specialties as |specialty|}}
                    <li><button type="button" class="npc-knowledge-row kind-specialty" data-item-id="{{specialty.item.id}}" data-action="item-edit" title="{{specialty.calculation}}"><span>{{specialty.item.name}}</span><span>{{specialty.level}}{{#if specialty.separateHands}} | {{specialty.offHandLevel}}{{/if}}</span></button></li>
                    {{/each}}
                  </ul>{{/if}}
                </li>
                {{/each}}
              </ul>{{/if}}
              {{#each tree.unassigned as |node|}}<button type="button" class="npc-knowledge-row kind-{{node.item.system.kind}}" data-item-id="{{node.item.id}}" data-action="item-edit" title="{{node.calculation}}"><span>{{node.item.name}}</span><span>{{node.level}}</span></button>{{/each}}
            </li>
            {{else}}{{#unless npcBookSkills.length}}<li class="empty">{{localize "TRUDVANG.Npc.NoLearnedSkills"}}</li>{{/unless}}{{/each}}
          </ul>
        </section>
        <section class="panel npc-abilities-panel">
          <h2>{{localize "TRUDVANG.Section.Capacities"}}</h2>
          <ol class="npc-ability-list">
            {{#each npcAbilities as |ability|}}
            <li><button type="button" class="npc-ability-row {{#if ability.disabled}}inactive{{/if}}" data-action="effect-edit" data-effect-uuid="{{ability.effectUuid}}" title="{{ability.summary}}"><img src="{{ability.img}}" alt=""><span>{{ability.name}}</span></button></li>
            {{else}}<li class="empty">{{localize "TRUDVANG.Npc.NoCapacities"}}</li>{{/each}}
          </ol>
        </section>
      </div>
    </div>
    <div class="tab actions" data-group="primary" data-tab="actions">
      <section class="panel"><div class="section-heading"><h2>{{localize "TRUDVANG.Tab.Actions"}}</h2><span><button type="button" data-action="item-create" data-type="weapon"><i class="fas fa-plus"></i></button><button type="button" data-action="item-create" data-type="ability"><i class="fas fa-star"></i></button></span></div><ol class="item-list">{{#each actor.items as |item|}}<li class="item" data-item-id="{{item.id}}"><img src="{{item.img}}"><button type="button" class="roll-icon" data-action="item-roll"><i class="fas fa-dice-d20"></i></button><button type="button" class="item-name" data-action="item-edit">{{item.name}}</button><span>{{#if item.system.damage}}{{item.system.damage}}{{/if}}{{#if item.system.rollBonus}}VC +{{item.system.rollBonus}}{{/if}}</span>{{#if item.system.damage}}<button type="button" data-action="item-damage"><i class="fas fa-burst"></i></button>{{/if}}<button type="button" data-action="item-delete"><i class="fas fa-trash"></i></button></li>{{/each}}</ol></section>
    </div>
    <div class="tab effects" data-group="primary" data-tab="effects"><section class="panel effects-panel"><div class="section-heading"><h2>{{localize "TRUDVANG.Section.Effects"}}</h2><span><button type="button" data-action="effect-add"><i class="fas fa-plus"></i> {{localize "TRUDVANG.Action.AddEffect"}}</button></span></div><ol class="effect-list">{{#each effects as |effect|}}<li class="effect-row {{#unless effect.active}}inactive{{/unless}}"><img src="{{effect.img}}"><button type="button" class="effect-name" data-action="effect-edit" data-effect-uuid="{{effect.uuid}}">{{effect.name}}</button><span class="effect-source">{{effect.source}}</span><span class="effect-duration"><i class="fas fa-clock"></i> {{effect.duration}}</span>{{#if effect.canEdit}}<button type="button" data-action="effect-toggle" data-effect-uuid="{{effect.uuid}}"><i class="fas {{#if effect.disabled}}fa-toggle-off{{else}}fa-toggle-on{{/if}}"></i></button><button type="button" data-action="effect-delete" data-effect-uuid="{{effect.uuid}}"><i class="fas fa-trash"></i></button>{{/if}}</li>{{else}}<li class="empty">{{localize "TRUDVANG.Empty.Effects"}}</li>{{/each}}</ol></section></div>
    <div class="tab notes" data-group="primary" data-tab="notes"><section class="panel editor-panel"><h2>{{localize "TRUDVANG.Section.Description"}}</h2>{{editor enriched.description target="system.description" button=true editable=editable}}</section><section class="panel editor-panel"><h2>{{localize "TRUDVANG.Section.Notes"}}</h2>{{editor enriched.notes target="system.notes" button=true editable=editable}}</section></div>
  </section>
</div>
