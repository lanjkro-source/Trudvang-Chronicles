<form class="{{cssClass}} trudvang-sheet npc-sheet" autocomplete="off">
  <header class="sheet-header compact">
    <img class="profile-img" src="{{actor.img}}" data-edit="img" title="{{actor.name}}">
    <div class="identity"><input class="actor-name" name="name" value="{{actor.name}}"><div class="identity-grid"><label>{{localize "TRUDVANG.Field.CreatureType"}}<input name="system.details.creatureType" value="{{system.details.creatureType}}"></label><label>{{localize "TRUDVANG.Field.Size"}}<input name="system.details.size" value="{{system.details.size}}"></label><label>{{localize "TRUDVANG.Field.FearFactor"}}<input name="system.details.fearFactor" value="{{system.details.fearFactor}}"></label><label>{{localize "TRUDVANG.Resource.Protection"}}<input name="system.details.naturalArmor" type="number" value="{{system.details.naturalArmor}}"></label></div></div>
    <button type="button" class="initiative-button" data-action="roll-initiative"><i class="fas fa-bolt"></i><strong>{{system.initiative.current}}</strong><span>{{localize "TRUDVANG.Resource.Initiative"}}</span></button>
  </header>
  <section class="resource-bar compact"><label class="resource body"><span>{{localize "TRUDVANG.Resource.Body"}}</span><span><input name="system.resources.body.value" type="number" value="{{system.resources.body.value}}"> / <input name="system.resources.body.max" type="number" value="{{system.resources.body.max}}"></span></label><label class="resource"><span>{{localize "TRUDVANG.Resource.Combat"}}</span><span><input name="system.resources.combat.value" type="number" value="{{system.resources.combat.value}}"> / {{system.resources.combat.max}}</span><button type="button" data-action="reset-combat"><i class="fas fa-rotate"></i></button></label><label class="resource"><span>{{localize "TRUDVANG.Resource.Movement"}}</span><input name="system.movement.current" type="number" value="{{system.movement.current}}"></label><label class="resource"><span>{{localize "TRUDVANG.Resource.Protection"}}</span><output>{{system.protection}}</output></label></section>
  <nav class="sheet-tabs tabs" data-group="primary"><a class="item" data-tab="summary">{{localize "TRUDVANG.Tab.Summary"}}</a><a class="item" data-tab="actions">{{localize "TRUDVANG.Tab.Actions"}}</a><a class="item" data-tab="notes">{{localize "TRUDVANG.Tab.Notes"}}</a></nav>
  <section class="sheet-body">
    <div class="tab summary" data-group="primary" data-tab="summary">
      <div class="npc-stats-grid"><section class="panel"><h2>{{localize "TRUDVANG.Section.Traits"}}</h2>{{#each config.traits as |label key|}}<div class="mini-stat"><button type="button" data-action="roll-trait" data-trait="{{key}}">{{label}}</button><input name="system.traits.{{key}}" type="number" value="{{lookup ../system.traits key}}"></div>{{/each}}</section><section class="panel"><h2>{{localize "TRUDVANG.Section.Skills"}}</h2>{{#each config.skills as |label key|}}{{#with (lookup ../system.skills key) as |skill|}}<div class="mini-stat"><button type="button" class="roll-icon" data-action="roll-skill" data-skill="{{key}}"><i class="fas fa-dice-d20"></i></button><button type="button" data-action="show-skill-detail" data-skill="{{key}}">{{label}}</button><input name="system.skills.{{key}}.value" type="number" value="{{skill.value}}"></div>{{/with}}{{/each}}</section></div>
    </div>
    <div class="tab actions" data-group="primary" data-tab="actions">
      <section class="panel"><div class="section-heading"><h2>{{localize "TRUDVANG.Tab.Actions"}}</h2><span><button type="button" data-action="item-create" data-type="weapon"><i class="fas fa-plus"></i></button><button type="button" data-action="item-create" data-type="ability"><i class="fas fa-star"></i></button></span></div><ol class="item-list">{{#each actor.items as |item|}}<li class="item" data-item-id="{{item.id}}"><img src="{{item.img}}"><button type="button" class="roll-icon" data-action="item-roll"><i class="fas fa-dice-d20"></i></button><button type="button" class="item-name" data-action="item-edit">{{item.name}}</button><span>{{#if item.system.damage}}{{item.system.damage}}{{/if}}{{#if item.system.rollBonus}}VC +{{item.system.rollBonus}}{{/if}}</span>{{#if item.system.damage}}<button type="button" data-action="item-damage"><i class="fas fa-burst"></i></button>{{/if}}<button type="button" data-action="item-delete"><i class="fas fa-trash"></i></button></li>{{/each}}</ol></section>
    </div>
    <div class="tab notes" data-group="primary" data-tab="notes"><section class="panel editor-panel"><h2>{{localize "TRUDVANG.Section.Description"}}</h2>{{editor enriched.description target="system.description" button=true editable=editable}}</section><section class="panel editor-panel"><h2>{{localize "TRUDVANG.Section.Notes"}}</h2>{{editor enriched.notes target="system.notes" button=true editable=editable}}</section></div>
  </section>
</form>
