<section class="senses-section" aria-label="{{localize 'TRUDVANG.Senses.Title'}}">
  <h3>{{localize "TRUDVANG.Senses.Title"}}</h3>
  <ul class="sensory-list">{{#each senses as |sense|}}<li class="{{#unless sense.enabled}}sense-disabled{{/unless}}"><i class="fas fa-eye" aria-hidden="true"></i> <strong>{{sense.label}}</strong>{{#unless (eq sense.type "normal")}} — {{sense.rangeLabel}}{{/unless}}{{#if sense.source}} <small>({{sense.source}})</small>{{/if}}{{#unless sense.enabled}} <small>{{localize "TRUDVANG.Senses.Disabled"}}</small>{{/unless}}</li>{{/each}}</ul>
  {{#if editable}}<details class="sensory-editor"><summary>{{localize "TRUDVANG.Senses.Edit"}}</summary>
    <p class="hint">{{localize "TRUDVANG.Senses.RangeHint"}}</p>
    {{#each baseSenses as |sense|}}<div class="sensory-row">
      <input type="checkbox" name="trudvang.senses.{{sense.index}}.enabled" {{checked sense.enabled}} aria-label="{{localize 'TRUDVANG.Senses.Enabled'}}">
      <select name="trudvang.senses.{{sense.index}}.type" aria-label="{{localize 'TRUDVANG.Senses.Type'}}">{{#each sense.types as |type|}}<option value="{{type.type}}" {{#if type.selected}}selected{{/if}}>{{type.label}}</option>{{/each}}</select>
      <input name="trudvang.senses.{{sense.index}}.label" value="{{sense.label}}" placeholder="{{localize 'TRUDVANG.Senses.Name'}}" aria-label="{{localize 'TRUDVANG.Senses.Name'}}">
      <input type="number" min="0" step="any" name="trudvang.senses.{{sense.index}}.range" value="{{sense.range}}" placeholder="∞" aria-label="{{localize 'TRUDVANG.Senses.Range'}}">
      <button type="button" data-action="sense-delete" data-index="{{sense.index}}" title="{{localize 'TRUDVANG.Senses.Remove'}}"><i class="fas fa-trash"></i></button>
    </div>{{/each}}
    <button type="button" data-action="sense-add"><i class="fas fa-plus"></i> {{localize "TRUDVANG.Senses.Add"}}</button>
  </details>{{/if}}
</section>
