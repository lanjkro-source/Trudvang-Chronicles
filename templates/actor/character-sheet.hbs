<div class="trudvang-sheet character-sheet">
  <header class="sheet-header">
    <img class="profile-img" src="{{actor.img}}" data-edit="img" title="{{actor.name}}">
    <div class="identity">
      <input class="actor-name" name="name" type="text" value="{{actor.name}}" placeholder="{{localize 'TRUDVANG.Field.Name'}}">
      <div class="identity-grid">
        <label>{{localize "TRUDVANG.Field.Race"}}
          <select name="system.details.race" {{#unless creationMode}}disabled{{/unless}}>{{selectOptions config.races selected=system.details.race}}</select>
        </label>
        <label>{{localize "TRUDVANG.Field.Culture"}}<select name="system.details.culture" {{#unless creationMode}}disabled{{/unless}}><option value=""></option>{{selectOptions config.cultures selected=system.details.culture}}</select></label>
        <label>{{localize "TRUDVANG.Field.NativeLanguage"}}<select name="system.details.nativeLanguage" {{#unless creationMode}}disabled{{/unless}}>{{selectOptions config.nativeLanguages selected=system.details.nativeLanguage}}</select></label>
        <div class="identity-secondary">
          <label>{{localize "TRUDVANG.Field.Religion"}}<select name="system.details.religion" {{#unless religionEditable}}disabled{{/unless}}><option value=""></option>{{selectOptions config.religions selected=system.details.religion}}</select></label>
          <label>{{localize "TRUDVANG.Field.Archetype"}}<select name="system.details.archetype" {{#unless creationMode}}disabled{{/unless}}><option value=""></option>{{selectOptions config.archetypes selected=system.details.archetype}}</select></label>
        </div>
      </div>
    </div>
    <div class="initiative-controls"><button type="button" class="initiative-button" data-action="roll-initiative" title="{{localize 'TRUDVANG.Action.RollInitiative'}}">
      <i class="fas fa-bolt"></i><strong>{{system.initiative.current}}</strong><span>{{localize "TRUDVANG.Resource.Initiative"}}</span>
    </button><button type="button" class="stat-inspect-button" data-action="inspect-global-stat" data-stat="initiative" title="{{localize 'TRUDVANG.Inspection.Inspect'}}"><i class="fas fa-circle-info"></i></button></div>
  </header>

  <section class="resource-bar">
    <label class="resource body"><span>{{localize "TRUDVANG.Resource.Body"}}</span><span><input name="system.resources.body.value" type="number" value="{{system.resources.body.value}}"> / {{system.resources.body.max}}</span></label>
    <label class="resource"><span>{{localize "TRUDVANG.Resource.Raud"}}</span><span><input name="system.resources.raud.value" type="number" value="{{system.resources.raud.value}}"> / <input name="system.resources.raud.max" type="number" value="{{system.resources.raud.max}}"></span></label>
    <label class="resource"><span>{{localize "TRUDVANG.Resource.Vitner"}}</span><span><input name="system.resources.vitner.value" type="number" value="{{system.resources.vitner.value}}"> / {{system.resources.vitner.max}}</span></label>
    <label class="resource"><span>{{localize "TRUDVANG.Resource.Divinity"}}</span><span><input name="system.resources.divinity.value" type="number" value="{{system.resources.divinity.value}}"> / {{system.resources.divinity.max}}</span></label>
    <label class="resource fear"><span>{{localize "TRUDVANG.Resource.Fear"}}</span><input name="system.resources.fear.value" type="number" value="{{system.resources.fear.value}}"></label>
  </section>
  <nav class="sheet-tabs tabs" data-group="primary">
    <a class="item" data-tab="summary"><i class="fas fa-shield-halved"></i> {{localize "TRUDVANG.Tab.Summary"}}</a>
    <a class="item" data-tab="combat"><i class="fas fa-swords"></i> {{localize "TRUDVANG.Tab.Combat"}}</a>
    <a class="item" data-tab="magic"><i class="fas fa-wand-sparkles"></i> {{localize "TRUDVANG.Tab.Magic"}}</a>
    <a class="item" data-tab="skills"><i class="fas fa-dice-d20"></i> {{localize "TRUDVANG.Tab.Skills"}}</a>
    <a class="item" data-tab="equipment"><i class="fas fa-backpack"></i> {{localize "TRUDVANG.Tab.Equipment"}}</a>
    <a class="item" data-tab="effects"><i class="fas fa-person-rays"></i> {{localize "TRUDVANG.Tab.Effects"}}</a>
    <a class="item" data-tab="notes"><i class="fas fa-book-open"></i> {{localize "TRUDVANG.Tab.Notes"}}</a>
  </nav>

  <section class="sheet-body">
    <div class="tab summary" data-group="primary" data-tab="summary">
      <div class="summary-grid">
        <section class="panel traits-panel">
          <h2>{{localize "TRUDVANG.Section.Traits"}}</h2>
          <div class="trait-grid">
            {{#each traitRows as |trait|}}
              <div class="trait-row" title="{{trait.tooltip}}">
                <button type="button" class="rollable" data-action="roll-trait" data-trait="{{trait.key}}"><i class="fas fa-dice-d20"></i> {{trait.label}}</button>
                <div class="level-control">{{#if @root.creationMode}}<button type="button" data-action="adjust-trait" data-trait="{{trait.key}}" data-direction="-1" title="{{trait.decreaseTitle}}" {{#unless trait.canDecrease}}disabled{{/unless}}><i class="fas fa-minus"></i></button>{{/if}}<strong class="{{#if trait.modified}}modified-value{{/if}}">{{signed trait.value}}</strong>{{#if trait.modified}}<small class="base-value" title="{{localize 'TRUDVANG.Effect.BaseValue'}}">{{signed trait.baseValue}}</small>{{/if}}{{#if @root.creationMode}}<button type="button" data-action="adjust-trait" data-trait="{{trait.key}}" data-direction="1" title="{{trait.increaseTitle}}" {{#unless trait.canIncrease}}disabled{{/unless}}><i class="fas fa-plus"></i></button>{{/if}}</div>
              </div>
            {{/each}}
          </div>
        </section>
        <section class="panel status-panel">
          <h2>{{localize "TRUDVANG.Section.Status"}}</h2>
          <dl class="status-list">
            <dt>{{localize "TRUDVANG.Resource.DamageLevel"}}</dt><dd>{{localize (concat "TRUDVANG.Damage." system.damage.level)}} ({{signed system.damage.penalty}})</dd>
            <dt>{{localize "TRUDVANG.Resource.Protection"}}</dt><dd><button type="button" class="inspectable-stat" data-action="inspect-global-stat" data-stat="protection">{{system.protection}} <i class="fas fa-circle-info"></i></button></dd>
            <dt>{{localize "TRUDVANG.Resource.Movement"}}</dt><dd><button type="button" class="inspectable-stat" data-action="inspect-global-stat" data-stat="movement">{{system.movement.current}} m <i class="fas fa-circle-info"></i></button></dd>
            <dt>{{localize "TRUDVANG.Resource.PersistenceInWild"}}</dt><dd>{{system.persistenceInWild}} {{localize "TRUDVANG.Unit.Days"}}</dd>
            <dt>{{localize "TRUDVANG.Resource.FearPenalty"}}</dt><dd>{{signed system.fearPenalty}}</dd>
            {{#if system.armorVCPenalty}}<dt>{{localize "TRUDVANG.Resource.ArmorVCPenalty"}}</dt><dd>-{{system.armorVCPenalty}}</dd>{{/if}}
          </dl>
        </section>
      </div>
    </div>

    <div class="tab combat" data-group="primary" data-tab="combat">
      <section class="panel combat-reserves-panel">
        <div class="section-heading"><h2>{{localize "TRUDVANG.Resource.CombatPools"}}</h2><span><button type="button" data-action="inspect-global-stat" data-stat="combat" title="{{localize 'TRUDVANG.Inspection.Inspect'}}"><i class="fas fa-circle-info"></i></button><button type="button" data-action="reset-combat"><i class="fas fa-rotate"></i> {{localize "TRUDVANG.Action.ResetCombat"}}</button></span></div>
        <div class="combat-pool-bar" aria-label="{{localize 'TRUDVANG.Resource.CombatPools'}}">{{#each combatPools as |pool|}}<span class="combat-pool {{#if pool.depleted}}depleted{{/if}}" title="{{pool.sourceTitle}}"><strong>{{pool.label}}</strong> {{pool.displayCurrent}}/{{pool.max}}</span>{{/each}}</div>
      </section>
      <section class="panel">
        <h2>{{localize "TRUDVANG.Section.CombatActions"}}</h2>
        <ol class="item-list combat-action-list">
          {{#each combatItems as |entry|}}<li class="item {{#unless entry.readied}}not-readied{{/unless}}" data-item-id="{{entry.item.id}}">
            <img src="{{entry.item.img}}"><button type="button" class="item-name" data-action="item-edit" title="{{entry.hoverTitle}}">{{entry.item.name}}</button><span class="item-detail">{{entry.hoverTitle}}</span>
            <button type="button" data-action="item-roll" title="{{localize 'TRUDVANG.Action.Attack'}}" {{#unless entry.readied}}disabled{{/unless}}><i class="fas fa-sword"></i></button>
            <button type="button" data-action="item-parry" title="{{localize 'TRUDVANG.Action.Parry'}}" {{#unless entry.readied}}disabled{{/unless}}><i class="fas fa-shield"></i></button>
            <button type="button" data-action="item-damage" title="{{localize 'TRUDVANG.Action.Damage'}}"><i class="fas fa-burst"></i></button>
            <button type="button" class="ready-action {{#if entry.readied}}active{{/if}}" data-action="item-ready" title="{{#if entry.readied}}{{localize 'TRUDVANG.Action.Sheathe'}}{{else}}{{localize 'TRUDVANG.Action.Draw'}}{{/if}}"><i class="fas {{#if entry.readied}}fa-box-archive{{else}}fa-hand-fist{{/if}}"></i></button>
          </li>{{else}}<li class="empty">{{localize "TRUDVANG.Empty.Weapons"}}</li>{{/each}}
        </ol>
      </section>
      <section class="panel">
        <h2>{{localize "TRUDVANG.Section.UnarmedCombat"}}</h2>
        <ol class="item-list combat-action-list"><li class="item natural-action"><img src="{{naturalWeapon.img}}"><span class="item-name">{{naturalWeapon.name}}</span><span class="item-detail">4 AA · 1d5</span><button type="button" data-action="natural-attack" title="{{localize 'TRUDVANG.Action.Attack'}}"><i class="fas fa-hand-fist"></i></button><button type="button" data-action="natural-parry" title="{{localize 'TRUDVANG.Action.Parry'}}"><i class="fas fa-shield"></i></button><button type="button" data-action="natural-damage" title="{{localize 'TRUDVANG.Action.Damage'}}"><i class="fas fa-burst"></i></button><span class="icon-placeholder"></span></li><li class="item natural-action"><img src="icons/svg/daze.svg"><span class="item-name">{{localize "TRUDVANG.Combat.Dodge"}}</span><span class="item-detail">{{localize "TRUDVANG.Field.SV"}} {{actor.dodgeTarget}}</span><button type="button" data-action="dodge-action" title="{{localize 'TRUDVANG.Combat.Dodge'}}"><i class="fas fa-person-running"></i></button><span class="icon-placeholder"></span><span class="icon-placeholder"></span><span class="icon-placeholder"></span></li><li class="item natural-action"><img src="icons/svg/wingfoot.svg"><span class="item-name">{{localize "TRUDVANG.Combat.MovementAction"}}</span><span class="item-detail">{{combatMovementHint}}</span><button type="button" data-action="movement-action" title="{{localize 'TRUDVANG.Combat.MovementAction'}}" {{#unless isInCombat}}disabled{{/unless}}><i class="fas fa-person-walking"></i></button><span class="icon-placeholder"></span><span class="icon-placeholder"></span><span class="icon-placeholder"></span></li></ol>
        <div class="wrestling-actions"><button type="button" data-action="wrestling-action" data-kind="grapple"><i class="fas fa-hands-bound"></i> {{localize "TRUDVANG.Combat.Grapple"}}</button><button type="button" data-action="wrestling-action" data-kind="glima"><i class="fas fa-person-falling"></i> {{localize "TRUDVANG.Combat.Glima"}}</button><small>{{localize "TRUDVANG.Combat.WrestlingHint"}}</small></div>
      </section>
    </div>

    <div class="tab skills" data-group="primary" data-tab="skills">
      <section class="panel">
        <div class="section-heading"><h2>{{localize "TRUDVANG.Section.Skills"}}</h2><span class="tree-controls"><button type="button" data-action="toggle-zero-knowledge"><i class="fas fa-eye-slash"></i> <span>{{localize "TRUDVANG.Action.HideUnlearned"}}</span></button><button type="button" data-action="expand-tree" title="{{localize 'TRUDVANG.Action.ExpandAll'}}"><i class="fas fa-angles-down"></i></button><button type="button" data-action="collapse-tree" title="{{localize 'TRUDVANG.Action.CollapseAll'}}"><i class="fas fa-angles-up"></i></button><button type="button" data-action="item-create" data-type="ability"><i class="fas fa-plus"></i> {{localize "TRUDVANG.Action.AddKnowledge"}}</button></span></div>
        <div class="knowledge-tree">
          {{#each skillTrees as |branch|}}
            <details class="skill-branch" data-tree-key="skill:{{branch.key}}" open>
              <summary><div class="skill-row tree-root">
                <button type="button" class="tree-toggle" data-action="toggle-tree" title="{{localize 'TRUDVANG.Action.ToggleTree'}}"><i class="fas fa-book-open"></i></button><button type="button" class="roll-icon" data-action="roll-skill" data-skill="{{branch.key}}" title="{{localize 'TRUDVANG.Action.Roll'}}"><i class="fas fa-dice-d20"></i></button><button type="button" class="skill-name" data-action="show-skill-detail" data-skill="{{branch.key}}" title="{{branch.description}}">{{branch.label}} {{#if branch.isCore}}<i class="fas fa-star core-skill-marker" title="{{localize 'TRUDVANG.Field.CoreSkill'}}"></i>{{/if}}</button>
                <span class="level-label">{{localize "TRUDVANG.Field.SV"}} <strong>{{branch.level}}</strong></span>
                <span class="cost-badge" title="{{branch.increaseTitle}}">+{{branch.nextCost}}</span>
                <div class="level-control">{{#if @root.creationMode}}<button type="button" data-action="adjust-skill" data-skill="{{branch.key}}" data-direction="-1" title="{{branch.decreaseTitle}}" {{#unless branch.canDecrease}}disabled{{/unless}}><i class="fas fa-minus"></i></button>{{/if}}<strong>{{branch.baseLevel}}</strong><button type="button" data-action="adjust-skill" data-skill="{{branch.key}}" data-direction="1" title="{{branch.increaseTitle}}" {{#unless branch.canIncrease}}disabled{{/unless}}><i class="fas fa-plus"></i></button></div>
              </div></summary>
              {{#each branch.disciplines as |node|}}
                <details class="discipline-branch {{#unless node.level}}zero-level{{/unless}}" data-tree-key="discipline:{{node.catalogId}}"><summary><div class="knowledge-node discipline-node" data-item-id="{{node.item.id}}" data-catalog-id="{{node.catalogId}}" title="{{node.calculation}}">
                  <button type="button" class="image-toggle" data-action="toggle-tree"><i class="fas {{#if node.level}}fa-book-open{{else}}fa-book{{/if}} book-icon{{#if node.level}} invested{{/if}}"></i></button><button type="button" class="roll-icon" data-action="roll-catalog" {{#unless node.level}}disabled{{/unless}}><i class="fas fa-dice-d20"></i></button>{{#if node.exists}}<button type="button" class="item-name" data-action="item-edit" title="{{node.summary}}">{{node.item.name}}</button>{{else}}<button type="button" class="item-name" data-action="show-catalog-detail" title="{{node.summary}}">{{node.item.name}}</button>{{/if}}<span class="kind-label">VC {{node.breakdown.total}}</span><span class="cost-badge" title="{{node.increaseTitle}}">+{{node.nextCost}}</span>
<div class="level-control">{{#if @root.creationMode}}<button type="button" data-action="adjust-catalog-knowledge" data-catalog-id="{{node.catalogId}}" data-direction="-1" title="{{node.decreaseTitle}}" {{#unless node.canDecrease}}disabled{{/unless}}><i class="fas fa-minus"></i></button>{{/if}}<strong>{{node.level}}</strong><button type="button" data-action="adjust-catalog-knowledge" data-catalog-id="{{node.catalogId}}" data-direction="1" title="{{node.increaseTitle}}" {{#unless node.canIncrease}}disabled{{/unless}}><i class="fas fa-plus"></i></button></div>

                </div></summary>
                {{#each node.specialties as |child|}}<div class="knowledge-node specialty-node {{#unless child.level}}{{#unless child.offHandLevel}}zero-level{{/unless}}{{/unless}} {{#if child.separateHands}}two-hand-levels{{/if}}" data-item-id="{{child.item.id}}" data-catalog-id="{{child.catalogId}}" title="{{child.calculation}}">
                  <i class="fas {{#if child.level}}fa-book-open{{else}}fa-book{{/if}} book-icon{{#if child.level}} invested{{/if}}"></i><button type="button" class="roll-icon" data-action="roll-catalog" {{#unless child.level}}{{#unless child.offHandLevel}}disabled{{/unless}}{{/unless}}><i class="fas fa-dice-d20"></i></button>{{#if child.exists}}<button type="button" class="item-name" data-action="item-edit" title="{{child.summary}}">{{child.item.name}}</button>{{else}}<button type="button" class="item-name" data-action="show-catalog-detail" title="{{child.summary}}">{{child.item.name}}</button>{{/if}}
                  <span class="kind-label">{{#if child.separateHands}}{{localize "TRUDVANG.Hand.WeaponShort"}} VC {{child.breakdown.total}} · {{localize "TRUDVANG.Hand.ShieldShort"}} VC {{child.offHandBreakdown.total}}{{else}}VC {{child.breakdown.total}}{{/if}}</span>
                  {{#if child.separateHands}}<div class="hand-level-pair">
                    <span class="hand-level" title="{{localize 'TRUDVANG.Hand.Weapon'}}"><small>{{localize "TRUDVANG.Hand.WeaponShort"}}</small><span class="cost-badge" title="{{child.increaseTitle}}">+{{child.nextCost}}</span><span class="level-control">{{#if @root.creationMode}}<button type="button" data-action="adjust-catalog-knowledge" data-catalog-id="{{child.catalogId}}" data-hand="weapon" data-direction="-1" title="{{child.decreaseTitle}}" {{#unless child.canDecrease}}disabled{{/unless}}><i class="fas fa-minus"></i></button>{{/if}}<strong>{{child.level}}</strong><button type="button" data-action="adjust-catalog-knowledge" data-catalog-id="{{child.catalogId}}" data-hand="weapon" data-direction="1" title="{{child.increaseTitle}}" {{#unless child.canIncrease}}disabled{{/unless}}><i class="fas fa-plus"></i></button></span></span>
                    <span class="hand-level" title="{{localize 'TRUDVANG.Hand.Shield'}}"><small>{{localize "TRUDVANG.Hand.ShieldShort"}}</small><span class="cost-badge" title="{{child.offHandIncreaseTitle}}">+{{child.offHandNextCost}}</span><span class="level-control">{{#if @root.creationMode}}<button type="button" data-action="adjust-catalog-knowledge" data-catalog-id="{{child.catalogId}}" data-hand="offHand" data-direction="-1" title="{{child.offHandDecreaseTitle}}" {{#unless child.offHandCanDecrease}}disabled{{/unless}}><i class="fas fa-minus"></i></button>{{/if}}<strong>{{child.offHandLevel}}</strong><button type="button" data-action="adjust-catalog-knowledge" data-catalog-id="{{child.catalogId}}" data-hand="offHand" data-direction="1" title="{{child.offHandIncreaseTitle}}" {{#unless child.offHandCanIncrease}}disabled{{/unless}}><i class="fas fa-plus"></i></button></span></span>
                  </div>{{else}}<span class="cost-badge" title="{{child.increaseTitle}}">+{{child.nextCost}}</span><div class="level-control">{{#if @root.creationMode}}<button type="button" data-action="adjust-catalog-knowledge" data-catalog-id="{{child.catalogId}}" data-direction="-1" title="{{child.decreaseTitle}}" {{#unless child.canDecrease}}disabled{{/unless}}><i class="fas fa-minus"></i></button>{{/if}}<strong>{{child.level}}</strong><button type="button" data-action="adjust-catalog-knowledge" data-catalog-id="{{child.catalogId}}" data-direction="1" title="{{child.increaseTitle}}" {{#unless child.canIncrease}}disabled{{/unless}}><i class="fas fa-plus"></i></button></div>{{/if}}
                </div>{{/each}}
                </details>
              {{/each}}
              {{#each branch.unassigned as |child|}}<div class="knowledge-node specialty-node orphan" data-item-id="{{child.item.id}}"><img src="{{child.item.img}}"><button type="button" class="roll-icon" data-action="item-roll"><i class="fas fa-dice-d20"></i></button><button type="button" class="item-name" data-action="item-edit" title="{{child.item.system.summary}}">{{child.item.name}}</button><span class="kind-label">{{localize "TRUDVANG.Field.Unassigned"}}</span><span class="cost-badge" title="{{child.increaseTitle}}">+{{child.nextCost}}</span><div class="level-control"><strong>{{child.item.system.level}}</strong><button type="button" data-action="adjust-item-level" data-direction="1" title="{{child.increaseTitle}}"><i class="fas fa-plus"></i></button></div></div>{{/each}}
            </details>
          {{/each}}
        </div>
      </section>
    </div>

    <div class="tab equipment" data-group="primary" data-tab="equipment">
      <section class="panel compact-bar money-weight-bar">
        <div class="coins">
          <label title="{{localize 'TRUDVANG.Field.CoinCopper'}}">Cu<input name="system.money.copper" type="number" min="0" max="9999" value="{{system.money.copper}}"></label>
          <label title="{{localize 'TRUDVANG.Field.CoinSilver'}}">Ag<input name="system.money.silver" type="number" min="0" max="9999" value="{{system.money.silver}}"></label>
          <label title="{{localize 'TRUDVANG.Field.CoinGold'}}">Or<input name="system.money.gold" type="number" min="0" max="9999" value="{{system.money.gold}}"></label>
        </div>
        <div class="weight-compact">{{localize "TRUDVANG.Field.TotalWeight"}}: <strong>{{totalWeight}} kg</strong></div>
      </section>
      <section class="panel">
        <div class="section-heading">
          <h2>{{localize "TRUDVANG.Section.Weapons"}}</h2><button type="button" data-action="item-create"
            data-type="weapon" data-tooltip="{{localize 'TRUDVANG.Action.Add'}} {{localize 'TYPES.Item.weapon'}}"><i class="fas fa-plus"></i> <i class="fas fa-sword"></i></button>
        </div>
        <ol class="item-list weapons-list">{{#each itemsByGroup.weapons as |item|}}<li class="item" data-item-id="{{item.id}}">
            <img src="{{item.img}}"><span class="icon-placeholder"></span><span class="icon-placeholder"></span><input class="qty-input" type="number" min="0" max="99"
              value="{{item.system.quantity}}" data-item-field="quantity" data-tooltip="{{localize 'TRUDVANG.Field.Quantity'}}"><span
              class="qty-sep">x</span><button type="button" class="item-name" data-action="item-edit"
              data-tooltip="{{item._shortTitle}}">{{item.name}}{{#if item._inspectionModified}} <span class="inspection-badge">Δ</span>{{/if}}</button><span class="item-detail">{{item._compactDetail}}</span><button
              type="button" class="equip {{#if item.system.equipped}}active{{/if}}" data-action="item-ready" data-tooltip="{{#if item.system.equipped}}{{localize 'TRUDVANG.Action.Sheathe'}}{{else}}{{localize 'TRUDVANG.Action.Draw'}}{{/if}}"><i
                class="fas fa-hand-fist"></i></button><button type="button" data-action="inspect-item" data-tooltip="{{localize 'TRUDVANG.Inspection.Inspect'}}"><i class="fas fa-magnifying-glass"></i></button><button type="button" data-action="item-delete" data-tooltip="{{localize 'TRUDVANG.Action.Delete'}}"><i
                class="fas fa-trash"></i></button></li>{{/each}}</ol>
      </section>
      <section class="panel">
        <div class="section-heading">
          <h2>{{localize "TRUDVANG.Section.Protection"}}</h2><span><button type="button" data-action="item-create"
              data-type="armor" data-tooltip="{{localize 'TRUDVANG.Action.Add'}} {{localize 'TYPES.Item.armor'}}"><i class="fas fa-plus"></i> <i
                class="fas fa-tshirt"></i></button><button type="button" data-action="item-create" data-type="shield"
              data-tooltip="{{localize 'TRUDVANG.Action.Add'}} {{localize 'TYPES.Item.shield'}}"><i class="fas fa-plus"></i> <i
                class="fas fa-shield"></i></button></span>
        </div>
        <ol class="item-list protection-list">{{#each itemsByGroup.protection as |item|}}<li class="item"
            data-item-id="{{item.id}}"><img src="{{item.img}}"><span class="icon-placeholder"></span><span class="icon-placeholder"></span><input
              class="qty-input" type="number" min="0" max="99" value="{{item.system.quantity}}" data-item-field="quantity"
              data-tooltip="{{localize 'TRUDVANG.Field.Quantity'}}"><span class="qty-sep">x</span><button type="button"
              class="item-name" data-action="item-edit" data-tooltip="{{item._shortTitle}}">{{item.name}}{{#if item._inspectionModified}} <span class="inspection-badge">Δ</span>{{/if}}</button>
              <span class="item-detail">{{item._compactDetail}}</span>{{#if (eq item.type "shield")}}<button
              type="button" class="equip {{#if item.system.equipped}}active{{/if}}" data-action="item-ready" data-tooltip="{{#if item.system.equipped}}{{localize 'TRUDVANG.Action.Sheathe'}}{{else}}{{localize 'TRUDVANG.Action.Draw'}}{{/if}}"><i
                class="fas fa-hand-fist"></i></button>{{else}}<button type="button" class="equip {{#if item.system.equipped}}active{{/if}}" data-action="item-equip" data-tooltip="{{localize 'TRUDVANG.Action.Equip'}}"><i class="fas fa-tshirt"></i></button>{{/if}}<button type="button"
              data-action="inspect-item" data-tooltip="{{localize 'TRUDVANG.Inspection.Inspect'}}"><i class="fas fa-magnifying-glass"></i></button><button type="button" data-action="item-delete" data-tooltip="{{localize 'TRUDVANG.Action.Delete'}}"><i class="fas fa-trash"></i></button></li>{{/each}}</ol>
      </section>
      <section class="panel">
        <div class="section-heading">
          <h2>{{localize "TRUDVANG.Section.Gear"}}</h2><span><button type="button" data-action="item-create"
              data-type="gear" data-tooltip="{{localize 'TRUDVANG.Action.Add'}} {{localize 'TYPES.Item.gear'}}"><i class="fas fa-plus"></i> <i
                class="fas fa-toolbox"></i></button><button type="button" data-action="item-create"
              data-type="potion" data-tooltip="{{localize 'TRUDVANG.Action.Add'}} {{localize 'TYPES.Item.potion'}}"><i class="fas fa-plus"></i> <i
                class="fas fa-flask"></i></button></span>
        </div>
        <ol class="item-list equipment-list">{{#each itemsByGroup.equipment as |item|}}<li class="item"
            data-item-id="{{item.id}}"><img src="{{item.img}}"><button type="button" class="roll-icon"
              data-action="item-roll"><i class="fas fa-dice-d20"></i></button><span class="icon-placeholder"></span><input
              class="qty-input" type="number" min="0" max="99" value="{{item.system.quantity}}" data-item-field="quantity"
              data-tooltip="{{localize 'TRUDVANG.Field.Quantity'}}"><span class="qty-sep">x</span><button type="button"
              class="item-name" data-action="item-edit" data-tooltip="{{item._shortTitle}}">{{item.name}}{{#if item._inspectionModified}} <span class="inspection-badge">Δ</span>{{/if}}</button><span
              class="item-detail">{{item._inspection.shortTitle}}</span><button type="button" data-action="inspect-item" data-tooltip="{{localize 'TRUDVANG.Inspection.Inspect'}}"><i class="fas fa-magnifying-glass"></i></button><span
              class="icon-placeholder"></span><button type="button" data-action="item-delete" data-tooltip="{{localize 'TRUDVANG.Action.Delete'}}"><i
                class="fas fa-trash"></i></button></li>{{/each}}</ol>
      </section>
    </div>

    <div class="tab magic" data-group="primary" data-tab="magic">
      <section class="panel"><h2>{{localize "TRUDVANG.Section.Affinities"}}</h2><dl class="status-list"><dt>{{localize "TRUDVANG.Field.VitnerType"}}</dt><dd>{{#if vitnerProfile}}{{localize vitnerProfile.label}} · {{localize "TRUDVANG.Resource.Vitner"}} {{system.resources.vitner.max}} · {{#if vitnerProfile.perfectSuccessMax}}{{localize "TRUDVANG.Field.PerfectSuccess"}} {{vitnerProfile.perfectSuccessMax}}{{else}}{{localize "TRUDVANG.Field.NoPerfectSuccess"}}{{/if}} · {{localize "TRUDVANG.Field.FatalDie"}} 1d10 (JO {{vitnerProfile.fatalRange}}){{else}}—{{/if}}</dd><dt>{{localize "TRUDVANG.Field.Religion"}}</dt><dd>{{#if religionProfile}}{{localize religionProfile.label}} · {{localize "TRUDVANG.Resource.Divinity"}} {{system.resources.divinity.max}}{{else}}—{{/if}}</dd></dl></section>
      <section class="panel">
        <div class="section-heading"><h2>{{localize "TRUDVANG.Section.Magic"}}</h2><span class="tree-controls"><button type="button" data-action="toggle-inactive-magic"><i class="fas fa-eye-slash"></i> <span>{{localize "TRUDVANG.Action.HideInactiveMagic"}}</span></button><button type="button" data-action="add-tablet"><i class="fas fa-plus"></i> {{localize "TRUDVANG.Action.AddTablet"}}</button></span></div>
        <div class="knowledge-tree magic-tree">
          {{#each magicTree as |node|}}
          <details class="magic-branch" data-tree-key="tablet:{{node.item.id}}" open>
            <summary><div class="knowledge-node tablet-node" data-item-id="{{node.item.id}}">
              <button type="button" class="image-toggle" data-action="toggle-tree"><img src="{{node.item.img}}"></button><button type="button" class="item-name" data-action="item-edit">{{node.item.name}}</button><span class="kind-label">{{localize (concat "TRUDVANG.Tablet." node.item.system.tabletType)}}</span><span class="cost-badge" title="{{node.increaseTitle}}">+{{node.nextCost}}</span><div class="level-control">{{#if @root.creationMode}}<button type="button" data-action="adjust-item-level" data-direction="-1" title="{{node.decreaseTitle}}" {{#unless node.canDecrease}}disabled{{/unless}}><i class="fas fa-minus"></i></button>{{/if}}<strong>{{node.item.system.level}}</strong><button type="button" data-action="adjust-item-level" data-direction="1" title="{{node.increaseTitle}}" {{#unless node.canIncrease}}disabled{{/unless}}><i class="fas fa-plus"></i></button></div>{{#if @root.creationMode}}<button type="button" data-action="item-delete"><i class="fas fa-trash"></i></button>{{/if}}
            </div></summary>
            {{#each node.children as |child|}}<div class="knowledge-node spell-node {{#if child.inactive}}inactive-magic{{/if}}" data-item-id="{{child.item.id}}"><img src="{{child.item.img}}"><button type="button" class="roll-icon" data-action="item-roll" {{#if child.inactive}}disabled{{/if}}><i class="fas fa-dice-d20"></i></button><button type="button" class="item-name" data-action="item-edit">{{child.item.name}}</button><span class="kind-label">{{localize (concat "TYPES.Item." child.item.type)}} · {{localize "TRUDVANG.Field.Level"}} {{child.item.system.level}}</span><span></span><span class="power-cost">{{localize "TRUDVANG.Field.Cost"}} {{child.item.system.cost}}</span></div>{{/each}}
          </details>
          {{/each}}
          {{#if unassignedMagic.length}}<h3>{{localize "TRUDVANG.Field.Unassigned"}}</h3>{{#each unassignedMagic as |item|}}<div class="knowledge-node spell-node orphan" data-item-id="{{item.id}}"><img src="{{item.img}}"><button type="button" class="roll-icon" data-action="item-roll"><i class="fas fa-dice-d20"></i></button><button type="button" class="item-name" data-action="item-edit">{{item.name}}</button><span class="kind-label">{{localize (concat "TYPES.Item." item.type)}}</span></div>{{/each}}{{/if}}
        </div>
      </section>
    </div>

    <div class="tab effects" data-group="primary" data-tab="effects">
      <section class="panel effects-panel">
        <div class="section-heading"><h2>{{localize "TRUDVANG.Section.Effects"}}</h2><span><button type="button" data-action="effect-add"><i class="fas fa-plus"></i> {{localize "TRUDVANG.Action.AddEffect"}}</button></span></div>
        <ol class="effect-list">
          {{#each effects as |effect|}}
            <li class="effect-row {{#unless effect.active}}inactive{{/unless}}" data-effect-uuid="{{effect.uuid}}" title="{{effect.summary}}">
              <img src="{{effect.img}}"><button type="button" class="effect-name" data-action="effect-edit" data-effect-uuid="{{effect.uuid}}">{{effect.name}}</button>
              <span class="effect-source">{{effect.source}}</span><span class="effect-duration"><i class="fas fa-clock"></i> {{effect.duration}}</span>
              {{#if effect.canEdit}}<button type="button" data-action="effect-toggle" data-effect-uuid="{{effect.uuid}}" title="{{localize 'TRUDVANG.Action.ToggleEffect'}}"><i class="fas {{#if effect.disabled}}fa-toggle-off{{else}}fa-toggle-on{{/if}}"></i></button><button type="button" data-action="effect-delete" data-effect-uuid="{{effect.uuid}}" title="{{localize 'TRUDVANG.Action.Delete'}}"><i class="fas fa-trash"></i></button>{{/if}}
            </li>
          {{else}}<li class="empty">{{localize "TRUDVANG.Empty.Effects"}}</li>{{/each}}
        </ol>
      </section>
    </div>

    <div class="tab notes" data-group="primary" data-tab="notes">
      <div class="notes-grid">
        <section class="panel editor-panel"><h2>{{localize "TRUDVANG.Section.Appearance"}}</h2>{{editor enriched.appearance target="system.appearance" button=true editable=editable}}</section>
        <section class="panel editor-panel"><h2>{{localize "TRUDVANG.Section.History"}}</h2>{{editor enriched.history target="system.history" button=true editable=editable}}</section>
        <section class="panel editor-panel full"><h2>{{localize "TRUDVANG.Section.Notes"}}</h2>{{editor enriched.notes target="system.notes" button=true editable=editable}}</section>
      </div>
    </div>
  </section>
  <footer class="progress-footer">
    <button type="button" class="creation-mode-button {{#if creationMode}}active{{/if}}" data-action="toggle-creation-mode"><i class="fas fa-user-pen"></i> {{#if creationMode}}{{localize "TRUDVANG.Action.FinishCreation"}}{{else}}{{localize "TRUDVANG.Action.StartCreation"}}{{/if}}</button>
    {{#if creationMode}}<div class="progress-values"><label>{{localize "TRUDVANG.Field.CreationTotal"}} <input name="system.experience.creationTotal" type="number" value="{{system.experience.creationTotal}}"></label><span>{{localize "TRUDVANG.Field.BuildCost"}} <strong>{{system.buildCost}}</strong></span><span>{{localize "TRUDVANG.Field.CreationRemaining"}} <strong>{{creationRemaining}}</strong></span><span title="{{localize 'TRUDVANG.Field.CoreBonusHint'}}">{{localize "TRUDVANG.Field.CoreBonus"}} <strong>{{creationCosts.coreBonusUsed}} / {{creationCosts.coreBonusTotal}}</strong></span></div>{{else}}<div class="progress-values"><label>{{localize "TRUDVANG.Field.AdventurePoints"}} <input name="system.experience.adventureAvailable" type="number" value="{{system.experience.adventureAvailable}}" {{#unless isGM}}disabled{{/unless}}></label><span>{{localize "TRUDVANG.Field.AdventureSpent"}} <strong>{{system.experience.adventureSpent}}</strong></span><span>{{localize "TRUDVANG.Field.PendingAdventurePoints"}} <strong>{{pendingAdventureCost}}</strong></span></div>{{/if}}
    {{#if pendingAdvancements.length}}<div class="footer-actions"><button type="button" data-action="confirm-advancement"><i class="fas fa-check"></i> {{localize "TRUDVANG.Action.ConfirmAdvancement"}}</button><button type="button" data-action="cancel-advancement"><i class="fas fa-rotate-left"></i> {{localize "TRUDVANG.Action.CancelAdvancement"}}</button></div>{{/if}}
  </footer>
</div>
