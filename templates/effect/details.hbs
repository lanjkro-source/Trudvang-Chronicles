<section class="tab {{tab.cssClass}}" data-tab="{{tab.id}}" data-group="{{tab.group}}">
  <fieldset>
    <legend>{{localize "EFFECT.Description"}}</legend>

    <div class="form-group stacked editor-container">{{#if editable}}<prose-mirror name="description" button="true" value="{{description}}" data-document-uuid="{{documentUuid}}" toggled>{{{enrichedDescription}}}</prose-mirror>{{else}}<div class="editor-content">{{{enrichedDescription}}}</div>{{/if}}</div>
    {{#if editable}}<button type="button" data-action="saveDescription" title="{{localize 'TRUDVANG.Effect.SaveDescription'}}"><i class="fa-solid fa-floppy-disk"></i> {{localize "TRUDVANG.Effect.SaveDescription"}}</button>{{/if}}
  </fieldset>
  <fieldset>
    <legend>{{localize "EFFECT.Origin"}}</legend>
    <div class="form-group">
      <input type="text" name="origin" value="{{origin}}" readonly>
    </div>
  </fieldset>
  <fieldset class="effect-statuses">
    <legend>{{localize "EFFECT.StatusConditions"}}</legend>
    <div class="form-group stacked">
      <multi-select name="statuses" {{#unless editable}}disabled{{/unless}} aria-label="{{localize 'EFFECT.StatusConditions'}}">
        {{#each statusChoices as |status|}}<option value="{{status.id}}" {{#if status.selected}}selected{{/if}}>{{status.label}}</option>{{/each}}
      </multi-select>
    </div>
  </fieldset>
</section>
