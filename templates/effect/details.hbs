<section class="tab {{tab.cssClass}}" data-tab="{{tab.id}}" data-group="{{tab.group}}">
  <fieldset>
    <legend>{{localize "EFFECT.Description"}}</legend>

    <div class="form-group stacked editor-container">{{#if editable}}<prose-mirror name="description" button="true" value="{{description}}" data-document-uuid="{{documentUuid}}" toggled>{{{enrichedDescription}}}</prose-mirror>{{else}}<div class="editor-content">{{{enrichedDescription}}}</div>{{/if}}</div>
    {{#if seal}}
      {{#if seal.spell}}
        <p><strong>{{localize "TRUDVANG.Seal.Stored" spell=seal.spell}}</strong></p>
        {{#if seal.improvements.length}}<ul>{{#each seal.improvements}}<li>{{count}} × {{text}}</li>{{/each}}</ul>{{/if}}
        {{#if seal.canRelease}}<button type="button" data-action="release-sealed-spell"><i class="fas fa-unlock" aria-hidden="true"></i> {{localize "TRUDVANG.Seal.Release"}}</button>{{/if}}
      {{else}}
        <p>{{localize "TRUDVANG.Seal.Maximum" level=seal.maximum}}</p>
        {{#if seal.canBind}}<button type="button" data-action="weave-sealed-spell"><i class="fas fa-wand-sparkles" aria-hidden="true"></i> {{localize "TRUDVANG.Seal.Bind"}}</button>{{/if}}
      {{/if}}
    {{/if}}
    {{#if resistanceButtons}}<div class="trudvang-transformation-links">{{#each resistanceButtons}}<button type="button" data-action="roll-rule-test" data-test-index="{{index}}"><i class="fas fa-dice-d20"></i> {{label}}</button>{{/each}}</div>{{/if}}
    {{#if canPullPrisoner}}<button type="button" data-action="pull-prisoner"><i class="fas fa-people-pulling" aria-hidden="true"></i> {{localize "TRUDVANG.FollowupTest.PrisonPull"}}</button>{{/if}}
    {{#if conditionalSituationButtons}}<div class="trudvang-transformation-links">{{#each conditionalSituationButtons}}<button type="button" data-action="roll-conditional-situation" data-index="{{index}}"><i class="fas fa-dice-d20"></i> {{label}}</button>{{/each}}</div>{{/if}}
    {{#if canRollMagicDamage}}<button type="button" data-action="roll-magic-damage"><i class="fas fa-burst"></i> {{localize "TRUDVANG.Action.RollDamage"}}</button>{{/if}}
    {{#if editable}}<button type="button" data-action="saveDescription" title="{{localize 'TRUDVANG.Effect.SaveDescription'}}"><i class="fa-solid fa-floppy-disk"></i> {{localize "TRUDVANG.Effect.SaveDescription"}}</button>{{/if}}
  </fieldset>
  <fieldset>
    <legend>{{localize "EFFECT.Origin"}}</legend>
    <div class="form-group">
      <input type="text" name="origin" value="{{origin}}" readonly>
    </div>
  </fieldset>
  {{#if canClassifyAffliction}}<div class="form-group"><label>{{localize "TRUDVANG.Cleansing.Classification"}}</label><div class="form-fields"><select name="trudvang.afflictionCategory">{{selectOptions afflictionChoices selected=afflictionCategory}}</select></div><p class="hint">{{localize "TRUDVANG.Cleansing.ClassificationHint"}}</p></div>{{/if}}
  <fieldset class="effect-statuses">
    <legend>{{localize "EFFECT.StatusConditions"}}</legend>
    <div class="form-group stacked">
      <multi-select name="statuses" {{#unless editable}}disabled{{/unless}} aria-label="{{localize 'EFFECT.StatusConditions'}}">
        {{#each statusChoices as |status|}}<option value="{{status.id}}" {{#if status.selected}}selected{{/if}}>{{status.label}}</option>{{/each}}
      </multi-select>
    </div>
  </fieldset>
</section>
