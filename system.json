{
  "id": "trudvang-chronicles",
  "title": "Trudvang Chronicles",
  "description": "A bilingual (English/French) Foundry VTT system for Trudvang Chronicles, using the official French terminology.",
  "version": "0.58.13",
  "url": "https://github.com/lanjkro-source/Trudvang-Chronicles",
  "manifest": "https://raw.githubusercontent.com/lanjkro-source/Trudvang-Chronicles/main/system.json",
  "download": "https://github.com/lanjkro-source/Trudvang-Chronicles/releases/download/v0.58.13/trudvang-chronicles.zip",
  "packs": [
    {
      "name": "skills-en",
      "label": "Skills (en)",
      "path": "packs/skills-en",
      "type": "Item",
      "system": "trudvang-chronicles",
      "banner": "systems/trudvang-chronicles/assets/banners/skills-en.webp"
    },
    {
      "name": "skills-fr",
      "label": "Compétences (fr)",
      "path": "packs/skills-fr",
      "type": "Item",
      "system": "trudvang-chronicles",
      "banner": "systems/trudvang-chronicles/assets/banners/skills-fr.webp"
    },
    {
      "name": "vitner-en",
      "label": "Vitner (en)",
      "path": "packs/vitner-en",
      "type": "Item",
      "system": "trudvang-chronicles",
      "banner": "systems/trudvang-chronicles/assets/banners/vitner-en.webp"
    },
    {
      "name": "vitner-fr",
      "label": "Vitner (fr)",
      "path": "packs/vitner-fr",
      "type": "Item",
      "system": "trudvang-chronicles",
      "banner": "systems/trudvang-chronicles/assets/banners/vitner-fr.webp"
    },
    {
      "name": "religion-en",
      "label": "Religion (en)",
      "path": "packs/religion-en",
      "type": "Item",
      "system": "trudvang-chronicles",
      "banner": "systems/trudvang-chronicles/assets/banners/religion-en.webp"
    },
    {
      "name": "religion-fr",
      "label": "Religion (fr)",
      "path": "packs/religion-fr",
      "type": "Item",
      "system": "trudvang-chronicles",
      "banner": "systems/trudvang-chronicles/assets/banners/religion-fr.webp"
    }
  ],
  "compatibility": {
    "minimum": "14",
    "verified": "14"
  },
  "authors": [
    {
      "name": "Trudvang Foundry Community"
    }
  ],
  "esmodules": [
    "trudvang.mjs"
  ],
  "styles": [
    "styles/trudvang.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    },
    {
      "lang": "fr",
      "name": "Français",
      "path": "lang/fr.json"
    }
  ],
  "documentTypes": {
    "ActiveEffect": {
      "effect": {}
    },
    "Actor": {
      "character": {
        "htmlFields": [
          "notes",
          "appearance",
          "history"
        ]
      },
      "npc": {
        "htmlFields": [
          "notes",
          "description"
        ]
      }
    },
    "Item": {
      "weapon": {
        "htmlFields": [
          "description"
        ]
      },
      "armor": {
        "htmlFields": [
          "description"
        ]
      },
      "shield": {
        "htmlFields": [
          "description"
        ]
      },
      "gear": {
        "htmlFields": [
          "description"
        ]
      },
      "potion": {
        "htmlFields": [
          "description",
          "effect"
        ]
      },
      "spell": {
        "htmlFields": [
          "description"
        ]
      },
      "tablet": {
        "htmlFields": [
          "description"
        ]
      },
      "divineFeat": {
        "htmlFields": [
          "description"
        ]
      },
      "ability": {
        "htmlFields": [
          "description"
        ]
      }
    }
  },
  "grid": {
    "distance": 1,
    "units": "m"
  },
  "primaryTokenAttribute": "resources.body",
  "secondaryTokenAttribute": "resources.combat",
  "initiative": "1d10x10 + @initiative.current",
  "socket": false,
  "background": "systems/trudvang-chronicles/assets/art/system-background.webp",
  "flags": {
    "hotReload": {
      "extensions": [
        "css",
        "hbs",
        "json",
        "mjs"
      ],
      "paths": [
        "styles",
        "templates",
        "lang",
        "modules",
        "data"
      ]
    }
  }
}
